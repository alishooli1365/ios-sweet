index 6630131..5055806 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -108,6 +108,9 @@ bsd/dev/sweet_ufs.c			standard
 bsd/dev/sweet_sample.c			standard
 bsd/dev/sweet_keys.c			standard
 bsd/dev/sweet_touch.c			standard
+bsd/dev/q2q_touch.c			standard
+bsd/dev/q2q_keys.c			standard
+bsd/dev/q2q_seed.c			standard
 bsd/dev/sweet_rpmh.c			standard
 bsd/dev/sweet_spmi.c			standard
