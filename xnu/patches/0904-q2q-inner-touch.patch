+/*
+ * One touch controller ("iPhone Duo": the inner one on SPI and the cover one on I2C both run,
+ * since iOS is mirrored on both panels). Only one side reports at a time: the side with the
+ * most recent new finger-down owns HID (a hand resting on the back, or the folded inner
+ * halves pressing on each other, never makes new presses), and palm events are dropped.
+ */
+struct qt_ctl {
+	bool on, i2c, cover;
+	uint32_t int_pin;
+	uint32_t mask;            /* fingers down now */
+	uint32_t active;          /* fingers reported down to HID */
+	int32_t hx[Q2QT_FINGERS], hy[Q2QT_FINGERS];
+	uint32_t rx[Q2QT_FINGERS], ry[Q2QT_FINGERS];
+	struct q2qt_map map;
+	uint64_t last_us;         /* last time a finger was down */
+	uint32_t events, ticks;
+	uint32_t prev;            /* mask at the previous poll (new presses = mask & ~prev) */
+	uint64_t press_us;        /* time of the latest new press */
+	/* calibration record: raw range seen, first and latest contact */
+	bool seen;
+	uint32_t xmin, xmax, ymin, ymax, x1, y1, xl, yl;
+};
+static struct qt_ctl qt_in, qt_cv;
+static struct qt_ctl *qt_owner;   /* side whose contacts go to HID (latest new press) */
+static uint32_t g80_seen, g26_seen;          /* fold pins: levels seen since boot (bit per level) */
+static uint32_t cv_press_g80 = 9, cv_press_g26 = 9;  /* pin levels at the latest cover press */
+/* fold sensor: q2qfold=0 off, 80 = TLMM gpio80 (folder_hall), 26 = gpio26 (hall);
+ * q2qfoldlvl = level that means folded (default 1) */
+static uint32_t qt_fold_mode, qt_fold_level = 1;
+static bool qt_folded;
+#define PIN_FOLDER_HALL 80u
+#define PIN_HALL        26u
+static unsigned qt_dl_off;    /* diagnostic line offset: 0 inner, 20 cover */
+
+static uint32_t
+qt_rd(vm_offset_t b, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(b + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+qt_wr(vm_offset_t b, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(b + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+qt_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&qt_sleep_chan, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+qt_diag(unsigned line, const char *text)
+{
+	sweet_fb_diag(line + qt_dl_off, text);
+	printf("Q2Q TOUCH: %s\n", text);
+}
+
+static uint64_t
+qt_now_us(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000u;
+}
+
+/* TLMM: function mux, pull (0 none, 1 down, 3 up), drive in mA, output enable + level. */
+static void
+qt_pin(uint32_t pin, uint32_t func, uint32_t pull, uint32_t ma, bool out, bool level)
+{
+	uint32_t cfg = qt_rd(qt.tlmm, TLMM_CFG(pin));
+	if (out) {
+		uint32_t io = qt_rd(qt.tlmm, TLMM_IO(pin));
+		qt_wr(qt.tlmm, TLMM_IO(pin), level ? (io | 2u) : (io & ~2u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= pull | (func << 2) | (((ma / 2u) - 1u) << 6) | (out ? (1u << 9) : 0u);
+	qt_wr(qt.tlmm, TLMM_CFG(pin), cfg);
+}
+
+static void
+qt_cs(bool high)
+{
+	uint32_t io = qt_rd(qt.tlmm, TLMM_IO(PIN_CS));
+	qt_wr(qt.tlmm, TLMM_IO(PIN_CS), high ? (io | 2u) : (io & ~2u));
+}
+
+static bool
+qt_clocks(void)
+{
+	char b[48];
+	uint32_t vote = qt_rd(qt.gcc, GCC_VOTE);
+	uint32_t s4 = qt_rd(qt.gcc, GCC_S4_CBCR), cfg = qt_rd(qt.gcc, GCC_S4_RCG + 4u);
+	snprintf(b, sizeof b, "V%05X S%08X", vote & 0xfffffu, s4);
+	qt_diag(DL_CLK, b);
+	qt_wr(qt.gcc, GCC_VOTE, vote | GCC_VOTE_BITS);
+	/* SE4 root: TCXO (source 0), no divider, no M/N; then latch it. */
+	qt_wr(qt.gcc, GCC_S4_RCG + 4u, 0);
+	qt_wr(qt.gcc, GCC_S4_RCG, qt_rd(qt.gcc, GCC_S4_RCG) | 1u);
+	bool latched = false;
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(qt_rd(qt.gcc, GCC_S4_RCG) & 1u)) {
+			latched = true;
+			break;
+		}
+		delay(1);
+	}
+	bool on = false;
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(qt_rd(qt.gcc, GCC_S4_CBCR) & CBCR_OFF) &&
+		    !(qt_rd(qt.gcc, GCC_CORE_CBCR) & CBCR_OFF)) {
+			on = true;
+			break;
+		}
+		delay(1);
+	}
+	snprintf(b, sizeof b, "CLK %s RCG%s C%X", on ? "ON" : "OFF", latched ? "OK" : "TO",
+	    cfg & 0xffffu);
+	qt_diag(DL_CLK, b);
+	return on && latched;
+}
+
+static bool
+qt_se_setup(unsigned div)
+{
+	char b[48];
+	uint32_t fw = qt_rd(qt.se, SE_FW_REV), hw = qt_rd(qt.se, SE_HW_PARAM0);
+	uint32_t ifd = qt_rd(qt.se, SE_IF_DISABLE), st = qt_rd(qt.se, SE_STATUS);
+	uint32_t proto = (fw >> 8) & 0xffu, width = (hw >> 24) & 0x3fu;
+	qt.depth = (hw >> 16) & 0x3fu;
+	snprintf(b, sizeof b, "SE FW%04X P%u S%X", fw & 0xffffu, proto, st & 0xfffu);
+	qt_diag(DL_SE, b);
+	snprintf(b, sizeof b, "FIFO D%u W%u IF%u", qt.depth, width, ifd & 1u);
+	qt_diag(DL_FIFO, b);
+	/*
+	 * The q2q bootloader leaves SE4 with SPI firmware but the FIFO interface disabled
+	 * (GSI-DMA only; seen on the device: FW 0x0102, D16 W32 IF1). GSI needs the GPI engine and
+	 * the SMMU, so the pins are driven directly instead (bit-banged SPI). q2qtbb=1 forces
+	 * that, q2qtbb=0 refuses it.
+	 */
+	int bbarg = -1;
+	(void)PE_parse_boot_argn("q2qtbb", &bbarg, sizeof(bbarg));
+	if (bbarg == 1 || ((ifd & 1u) && bbarg != 0)) {
+		qt.bb = true;
+		snprintf(b, sizeof b, "MODE BITBANG %uUS", qt.bb_us);
+		qt_diag(DL_FIFO, b);
+		return true;
+	}
+	if (proto != GENI_PROTO_SPI || width != 32u || qt.depth < 4u || (ifd & 1u)) {
+		qt_diag(DL_STATE, "STOP: SE4 NOT SPI FIFO");
+		return false;
+	}
+	if (st & 1u) {
+		qt_diag(DL_STATE, "STOP: SE4 BUSY");
+		return false;
+	}
+	qt_wr(qt.se, SE_GSI_EVT, 0);
+	qt_wr(qt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	qt_wr(qt.se, SE_S_IRQ_CLR, 0xffffffffu);
+	qt_wr(qt.se, SE_IRQ_ROUTE, 0);          /* nothing to the GIC: polled */
+	qt_wr(qt.se, SE_CGC_CTRL, qt_rd(qt.se, SE_CGC_CTRL) | 0x7fu);
+	qt_wr(qt.se, SE_DMA_GEN_CFG, qt_rd(qt.se, SE_DMA_GEN_CFG) | 0x0fu);
+	qt_wr(qt.se, SE_OUTPUT_CTRL, 0x7fu);
+	qt_wr(qt.se, SE_FORCE_DEF, 1u);
+	qt_wr(qt.se, SE_DMA_MODE, 0);           /* FIFO mode */
+	qt_wr(qt.se, SE_TX_WM, 0);
+	qt_wr(qt.se, SE_RX_WM, 0);
+	qt_wr(qt.se, SE_RX_RFR, qt.depth - 2u);
+	qt_wr(qt.se, SE_M_IRQ_EN, M_DONE | M_ERRORS | (1u << 26) | (1u << 27) | (1u << 30));
+	/* SPI mode 0, chip select 0 (unused: CS is GPIO23), 8-bit words, MSB first. */
+	qt_wr(qt.se, SE_SPI_LOOPBACK, 0);
+	qt_wr(qt.se, SE_SPI_DMX_SEL, 0);
+	qt_wr(qt.se, SE_SPI_CPHA, 0);
+	qt_wr(qt.se, SE_SPI_CPOL, 0);
+	qt_wr(qt.se, SE_SPI_DMX_INV, 0);
+	qt_wr(qt.se, SE_SPI_WORD_LEN, 8u - 4u);
+	qt_wr(qt.se, SE_TX_PACK0, 0x0007f8feu);
+	qt_wr(qt.se, SE_TX_PACK1, 0x000ffefeu);
+	qt_wr(qt.se, SE_RX_PACK0, 0x0007f8feu);
+	qt_wr(qt.se, SE_RX_PACK1, 0x000ffefeu);
+	qt_wr(qt.se, SE_BYTE_GRAN, 0);
+	qt_wr(qt.se, SE_SPI_TRANS, qt_rd(qt.se, SE_SPI_TRANS) & ~2u);   /* no CS toggle */
+	qt_wr(qt.se, SE_CLK_SEL, 0);
+	qt_wr(qt.se, SE_M_CLK_CFG, (div << 4) | 1u);
+	return true;
+}
+
+/* Bit-banged SPI pin operations (TLMM IO register: bit 1 output level, bit 0 input level). */
+static void
+qt_bb_clk(void *ctx, int level)
+{
+	(void)ctx;
+	*(volatile uint32_t *)(qt.tlmm + TLMM_IO(PIN_CLK)) = level ? 2u : 0u;
+}
+
+static void
+qt_bb_mosi(void *ctx, int level)
+{
+	(void)ctx;
+	*(volatile uint32_t *)(qt.tlmm + TLMM_IO(PIN_MOSI)) = level ? 2u : 0u;
+}
+
+static int
+qt_bb_miso(void *ctx)
+{
+	(void)ctx;
+	__asm__ volatile ("dsb sy" ::: "memory");   /* clock edge reached the pin first */
+	return (int)(*(volatile uint32_t *)(qt.tlmm + TLMM_IO(PIN_MISO)) & 1u);
+}
+
+static void
+qt_bb_wait(void *ctx)
+{
+	(void)ctx;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (qt.bb_us) {
+		delay((int)qt.bb_us);
+	}
+}
+
+static const struct q2qt_bb_ops qt_bb_ops = {
+	qt_bb_clk, qt_bb_mosi, qt_bb_miso, qt_bb_wait, NULL,
+};
+
+/*
+ * PMIC I2C on gpio76/77: open drain emulated with the output latch at 0, toggling only the
+ * output enable (released = input; the board has pull-ups: Samsung's pinctrl is bias-disable).
+ */
+struct qt_i2c_bus {
+	uint32_t sda, scl;
+	uint32_t pull;            /* TLMM pull while released: 0 none (board pull-ups), 3 up */
+	uint32_t us;              /* quarter bit period */
+};
+static struct qt_i2c_bus qt_pm_bus = { PIN_PM_SDA, PIN_PM_SCL, 0, 3 };
+static struct qt_i2c_bus qt_ts_bus = { PIN_CT_SDA, PIN_CT_SCL, 3, 2 };
+
+static void
+qt_od(uint32_t pin, int release, uint32_t pull)
+{
+	*(volatile uint32_t *)(qt.tlmm + TLMM_CFG(pin)) = release ? pull : (1u << 9);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void qt_i2c_sda(void *ctx, int r) { struct qt_i2c_bus *b = ctx; qt_od(b->sda, r, b->pull); }
+static void qt_i2c_scl(void *ctx, int r) { struct qt_i2c_bus *b = ctx; qt_od(b->scl, r, b->pull); }
+static int qt_i2c_sda_in(void *ctx) { struct qt_i2c_bus *b = ctx; return (int)(qt_rd(qt.tlmm, TLMM_IO(b->sda)) & 1u); }
+static int qt_i2c_scl_in(void *ctx) { struct qt_i2c_bus *b = ctx; return (int)(qt_rd(qt.tlmm, TLMM_IO(b->scl)) & 1u); }
+static void qt_i2c_wait(void *ctx) { struct qt_i2c_bus *b = ctx; delay((int)b->us); }
+
+static const struct q2qt_i2c_ops qt_i2c_ops = {
+	qt_i2c_sda, qt_i2c_scl, qt_i2c_sda_in, qt_i2c_scl_in, qt_i2c_wait, &qt_pm_bus,
+};
+static const struct q2qt_i2c_ops qt_ts_ops = {
+	qt_i2c_sda, qt_i2c_scl, qt_i2c_sda_in, qt_i2c_scl_in, qt_i2c_wait, &qt_ts_bus,
+};
+
+/* Release both lines of a bit-banged bus (output latch 0, input with the bus's pull). */
+static void
+qt_i2c_idle(const struct qt_i2c_bus *b)
+{
+	qt_wr(qt.tlmm, TLMM_IO(b->sda), 0);
+	qt_wr(qt.tlmm, TLMM_IO(b->scl), 0);
+	qt_od(b->sda, 1, b->pull);
+	qt_od(b->scl, 1, b->pull);
+	delay(50);
+}
+
+/*
+ * Cover touch power: s2mpb02 LDO8 (1.8 V IO) and LDO14 (2.8 V AVDD) on the same i2c@52 bus.
+ * Each control register holds only the enable bit and the voltage selector; read first, write
+ * nothing if the PMIC does not answer, never touch any other regulator.
+ */
+static bool
+qt_power_cover(void)
+{
+	char b[48];
+	uint8_t l8 = 0, l14 = 0, l8b = 0, l14b = 0;
+	const uint8_t want8 = S2MPB02_LDO_EN | S2MPB02_SEL_1V8, want14 = S2MPB02_LDO_EN | S2MPB02_SEL_2V8;
+	qt_i2c_idle(&qt_pm_bus);
+	int e = q2qt_i2c_read_reg(&qt_i2c_ops, S2MPB02_ADDR, S2MPB02_L8CTRL, &l8);
+	if (!e) e = q2qt_i2c_read_reg(&qt_i2c_ops, S2MPB02_ADDR, S2MPB02_L14CTRL, &l14);
+	if (e) {
+		snprintf(b, sizeof b, "PMB NO ANSWER E%d", e);
+		qt_diag(DL_PMIC, b);
+		return false;
+	}
+	snprintf(b, sizeof b, "PMB L8 %02X L14 %02X", l8, l14);
+	qt_diag(DL_PMIC, b);
+	if (l8 != want8) {
+		e |= q2qt_i2c_write_reg(&qt_i2c_ops, S2MPB02_ADDR, S2MPB02_L8CTRL, want8);
+	}
+	if (l14 != want14) {
+		e |= q2qt_i2c_write_reg(&qt_i2c_ops, S2MPB02_ADDR, S2MPB02_L14CTRL, want14);
+	}
+	qt_sleep_ms(20);
+	int e2 = q2qt_i2c_read_reg(&qt_i2c_ops, S2MPB02_ADDR, S2MPB02_L8CTRL, &l8b);
+	if (!e2) e2 = q2qt_i2c_read_reg(&qt_i2c_ops, S2MPB02_ADDR, S2MPB02_L14CTRL, &l14b);
+	snprintf(b, sizeof b, "PWRB %02X %02X %s", l8b, l14b, (e || e2) ? "ERR" : "OK");
+	qt_diag(DL_PWR, b);
+	return !e && !e2 && l8b == want8 && l14b == want14;
+}
+
+/*
+ * Touch power: s2dos05 LDO2 (1.8 V IO) and LDO3 (3.0 V AVDD). The bootloader leaves them off
+ * (seen: chip id all zero, interrupt line low). Read first; only ever SET the two enable bits
+ * (LDO1 / BUCK1 power the panel and must stay as they are); nothing is written if the PMIC does
+ * not answer. Returns true when both are on afterwards.
+ */
+static bool
+qt_power(void)
+{
+	char b[48];
+	uint8_t id = 0, en = 0, l2 = 0, l3 = 0, en2 = 0;
+	snprintf(b, sizeof b, "PMP %03X %03X", qt_rd(qt.tlmm, TLMM_CFG(PIN_PM_SDA)) & 0x3ffu,
+	    qt_rd(qt.tlmm, TLMM_CFG(PIN_PM_SCL)) & 0x3ffu);
+	qt_diag(DL_PMIC, b);
+	qt_i2c_idle(&qt_pm_bus);
+	int e = q2qt_i2c_read_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_DEV_ID, &id);
+	if (!e) e = q2qt_i2c_read_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_EN, &en);
+	if (!e) e = q2qt_i2c_read_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_LDO2_CFG, &l2);
+	if (!e) e = q2qt_i2c_read_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_LDO3_CFG, &l3);
+	if (e) {
+		snprintf(b, sizeof b, "PM NO ANSWER E%d", e);
+		qt_diag(DL_PMIC, b);
+		return false;
+	}
+	snprintf(b, sizeof b, "PM%02X EN%02X L%02X %02X", id, en, l2, l3);
+	qt_diag(DL_PMIC, b);
+	if ((l2 & S2DOS05_VSEL) != S2DOS05_SEL_1V8) {
+		e |= q2qt_i2c_write_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_LDO2_CFG,
+		    (uint8_t)((l2 & ~S2DOS05_VSEL) | S2DOS05_SEL_1V8));
+	}
+	if ((l3 & S2DOS05_VSEL) != S2DOS05_SEL_3V0) {
+		e |= q2qt_i2c_write_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_LDO3_CFG,
+		    (uint8_t)((l3 & ~S2DOS05_VSEL) | S2DOS05_SEL_3V0));
+	}
+	if ((en & (S2DOS05_EN_L2 | S2DOS05_EN_L3)) != (S2DOS05_EN_L2 | S2DOS05_EN_L3)) {
+		e |= q2qt_i2c_write_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_EN,
+		    (uint8_t)(en | S2DOS05_EN_L2 | S2DOS05_EN_L3));
+	}
+	qt_sleep_ms(20);
+	int e2 = q2qt_i2c_read_reg(&qt_i2c_ops, S2DOS05_ADDR, S2DOS05_EN, &en2);
+	snprintf(b, sizeof b, "PWR EN%02X>%02X %s", en, en2, (e || e2) ? "ERR" : "OK");
+	qt_diag(DL_PWR, b);
+	return !e && !e2 && (en2 & (S2DOS05_EN_L2 | S2DOS05_EN_L3)) == (S2DOS05_EN_L2 | S2DOS05_EN_L3);
+}
+
+/* One full-duplex SPI transfer of n bytes with CS (GPIO23) held low. */
+static int
+qt_xfer(const uint8_t *tx, uint8_t *rx, uint32_t n)
+{
+	uint32_t ti = 0, ri = 0, irq = 0;
+	int err = 0;
+	qt.xfers++;
+	if (qt.bb) {
+		qt_cs(false);
+		delay(2);
+		q2qt_bb_xfer(&qt_bb_ops, tx, rx, n);
+		delay(2);
+		qt_cs(true);
+		delay(5);
+		return 0;
+	}
+	qt_cs(false);
+	qt_wr(qt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	qt_wr(qt.se, SE_SPI_TX_LEN, n);
+	qt_wr(qt.se, SE_SPI_RX_LEN, n);
+	qt_wr(qt.se, SE_M_CMD0, SPI_FULL_DUPLEX << 27);
+	uint64_t t0 = qt_now_us();
+	for (;;) {
+		uint32_t used = qt_rd(qt.se, SE_TX_STATUS) & 0x0fffffffu;
+		while (ti < n && used < qt.depth) {
+			uint32_t k = n - ti < 4u ? n - ti : 4u;
+			qt_wr(qt.se, SE_TX_FIFO, q2qt_pack(tx + ti, k));
+			ti += k;
+			used++;
+		}
+		uint32_t words = qt_rd(qt.se, SE_RX_STATUS) & 0x01ffffffu;
+		while (words-- > 0) {
+			uint32_t w = qt_rd(qt.se, SE_RX_FIFO);
+			if (ri < n) {
+				uint32_t k = n - ri < 4u ? n - ri : 4u;
+				q2qt_unpack(w, rx + ri, k);
+				ri += k;
+			}
+		}
+		irq = qt_rd(qt.se, SE_M_IRQ);
+		if (irq & M_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if ((irq & M_DONE) && ri >= n) {
+			break;
+		}
+		if (qt_now_us() - t0 > 20000u) {
+			err = ETIMEDOUT;
+			break;
+		}
+	}
+	if (err) {
+		/* Cancel, then abort, the command so the engine is idle for the next one. */
+		qt_wr(qt.se, SE_M_CMD_CTRL, 1u << 2);
+		for (unsigned i = 0; i < 1000 && !(qt_rd(qt.se, SE_M_IRQ) & (M_CANCEL_DONE | M_DONE)); i++) {
+			delay(1);
+		}
+		if (qt_rd(qt.se, SE_STATUS) & 1u) {
+			qt_wr(qt.se, SE_M_CMD_CTRL, 1u << 1);
+			for (unsigned i = 0; i < 1000 && !(qt_rd(qt.se, SE_M_IRQ) & M_ABORT_DONE); i++) {
+				delay(1);
+			}
+		}
+		for (unsigned i = 0; i < 64 && (qt_rd(qt.se, SE_RX_STATUS) & 0x01ffffffu); i++) {
+			(void)qt_rd(qt.se, SE_RX_FIFO);
+		}
+		if ((qt.errors++ % 50u) == 0) {
+			char b[48];
+			snprintf(b, sizeof b, "XFER %s IRQ%08X", err == EIO ? "ERR" : "TO", irq);
+			qt_diag(DL_ERR, b);
+		}
+	}
+	qt_wr(qt.se, SE_M_IRQ_CLR, 0xffffffffu);
+	qt_cs(true);
+	delay(5);
+	return err;
+}
+
+static uint8_t qt_tx[2 + Q2QT_FIFO_MAX * Q2QT_EVENT_SIZE + 8];
+static uint8_t qt_rxb[sizeof(qt_tx)];
+
+static int
+qt_write(const uint8_t *cmd, uint32_t n)
+{
+	if (qt.i2c) {          /* I2C controller: the command bytes as they are */
+		qt.xfers++;
+		return q2qt_i2c_xfer(&qt_ts_ops, CT_ADDR, cmd, n, NULL, 0) ? EIO : 0;
+	}
+	uint32_t len = q2qt_frame_write(cmd, n, qt_tx, sizeof(qt_tx));
+	return len ? qt_xfer(qt_tx, qt_rxb, len) : EINVAL;
+}
+
+static int
+qt_read(const uint8_t *reg, uint32_t tlen, uint8_t *out, uint32_t rlen)
+{
+	uint32_t off = 0;
+	int pre = 0;
+	if (qt.i2c) {          /* write the register, repeated START, read (no turnaround byte) */
+		qt.xfers++;
+		int e = q2qt_i2c_xfer(&qt_ts_ops, CT_ADDR, reg, tlen, out, rlen);
+		if (e && (qt.errors++ % 50u) == 0) {
+			char b[48];
+			snprintf(b, sizeof b, "I2C ERR %d REG %02X", e, reg[0]);
+			qt_diag(DL_ERR, b);
+		}
+		return e ? EIO : 0;
+	}
+	uint32_t len = q2qt_frame_read(reg, tlen, rlen, qt_tx, sizeof(qt_tx), &off, &pre);
+	if (len == 0) {
+		return EINVAL;
+	}
+	if (pre) {
+		uint8_t w[8];
+		uint32_t wl = q2qt_frame_write(reg, tlen, w, sizeof(w));
+		int e = wl ? qt_xfer(w, qt_rxb, wl) : EINVAL;
+		if (e) {
+			return e;
+		}
+		(void)q2qt_frame_read(reg, tlen, rlen, qt_tx, sizeof(qt_tx), &off, &pre);
+	}
+	int err = qt_xfer(qt_tx, qt_rxb, len);
+	if (!err) {
+		for (uint32_t i = 0; i < rlen; i++) {
+			out[i] = qt_rxb[off + i];
+		}
+	}
+	return err;
+}
+
+static void
+qt_report(struct qt_ctl *c, uint32_t mask)
+{
+	for (uint32_t id = 0; id < Q2QT_FINGERS; id++) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			sweet_hid_touch((int)id, 1, c->hx[id], c->hy[id]);
+		} else if (c->active & bit) {
+			sweet_hid_touch((int)id, 0, c->hx[id], c->hy[id]);
+		}
+	}
+	c->active = mask;
+}
+
+/* Read all pending events of controller c; returns the number of events read, or -errno. */
+static int
+qt_poll(struct qt_ctl *c, bool *changed)
+{
+	static uint8_t evs[Q2QT_FIFO_MAX * Q2QT_EVENT_SIZE];
+	uint32_t *mask = &c->mask;
+	qt.i2c = c->i2c;
+	/* SPI (inner): 0x87 for one and for the rest; I2C (cover): 0x60 one, 0x61 all */
+	const uint8_t cmd = qt.i2c ? 0x60 : 0x87, cmd_all = qt.i2c ? 0x61 : 0x87;
+	int err = qt_read(&cmd, 1, evs, Q2QT_EVENT_SIZE);
+	if (err) {
+		return -err;
+	}
+	struct q2qt_ev o;
+	q2qt_parse(evs, &o);
+	if (o.kind == Q2QT_EV_NONE) {
+		return 0;
+	}
+	uint32_t count = 1 + (o.left < Q2QT_FIFO_MAX ? o.left : Q2QT_FIFO_MAX - 1u);
+	if (count > 1) {
+		err = qt_read(&cmd_all, 1, evs + Q2QT_EVENT_SIZE, (count - 1) * Q2QT_EVENT_SIZE);
+		if (err) {
+			count = 1;
+		}
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		q2qt_parse(evs + i * Q2QT_EVENT_SIZE, &o);
+		qt.events++;
+		c->events++;
+		if (o.kind == Q2QT_EV_ERROR) {
+			char b[48];
+			q2qt_hex(b, sizeof b, evs + i * Q2QT_EVENT_SIZE, 6);
+			qt_diag(DL_ERR, b);
+			continue;
+		}
+		if (o.kind != Q2QT_EV_TOUCH) {
+			continue;
+		}
+		uint32_t bit = 1u << o.tid;
+		if (o.action == Q2QT_ACT_RELEASE) {
+			if (*mask & bit) {
+				*mask &= ~bit;
+				*changed = true;
+			}
+			continue;
+		}
+		if (o.ttype == 5u) {    /* palm: never a touch */
+			continue;
+		}
+		if (!c->seen) {
+			c->seen = true;
+			c->x1 = c->xmin = c->xmax = o.x;
+			c->y1 = c->ymin = c->ymax = o.y;
+		}
+		c->xmin = o.x < c->xmin ? o.x : c->xmin;
+		c->xmax = o.x > c->xmax ? o.x : c->xmax;
+		c->ymin = o.y < c->ymin ? o.y : c->ymin;
+		c->ymax = o.y > c->ymax ? o.y : c->ymax;
+		c->xl = o.x;
+		c->yl = o.y;
+		uint32_t fx, fy;
+		int32_t hx, hy;
+		q2qt_raw_to_view(&c->map, o.x, o.y, &fx, &fy);
+		int m = c->cover ? sweet_fb_touch_to_hid_cover(fx, fy, &hx, &hy) :
+		    sweet_fb_touch_to_hid(fx, fy, &hx, &hy);
+		if (m < 0) {
+			continue;   /* that panel is not presenting: no mapping */
+		}
+		if (!(*mask & bit) || hx != c->hx[o.tid] || hy != c->hy[o.tid]) {
+			*changed = true;
+		}
+		*mask |= bit;
+		c->rx[o.tid] = o.x;
+		c->ry[o.tid] = o.y;
+		c->hx[o.tid] = hx;
+		c->hy[o.tid] = hy;
+	}
+	return (int)count;
+}
+
+static bool
+qt_chip_start(void)
+{
+	char b[48], h[40];
+	uint8_t id[5] = {0}, hw[8] = {0}, ev[Q2QT_EVENT_SIZE];
+	const uint8_t rid = 0x22, rhw[5] = {0xFB, 0x20, 0x00, 0x00, 0x00};
+	const uint8_t reset[6] = {0xFA, 0x20, 0x00, 0x00, 0x24, 0x81};
+	const uint8_t ttype[3] = {0x30, 0x00, 0x61}, clr = 0x62, scan[3] = {0xA0, 0x00, 0x01};
+	const uint8_t inten[3] = {0xA4, 0x01, 0x01}, rev = qt.i2c ? 0x60 : 0x87;
+	struct q2qt_ev o;
+
+	sweet_fb_diag_stage = 70;
+	qt_diag(DL_STEP, "STEP CHIP ID");
+	int e = qt_read(&rid, 1, id, sizeof(id));
+	q2qt_hex(h, sizeof h, id, 5);
+	snprintf(b, sizeof b, "ID%s %s", e ? "ERR" : "", h);
+	qt_diag(DL_ID, b);
+	e = qt_read(rhw, 5, hw, sizeof(hw));
+	q2qt_hex(h, sizeof h, hw, 6);
+	snprintf(b, sizeof b, "HW%s %s", e ? "ERR" : "", h);
+	qt_diag(DL_HWID, b);
+
+	sweet_fb_diag_stage = 71;
+	qt_diag(DL_STEP, "STEP RESET");
+	(void)qt_write(reset, sizeof(reset));
+	qt_sleep_ms(30);
+	bool ready = false;
+	unsigned tries = 0;
+	for (; tries < 60 && !ready; tries++) {
+		if (qt_read(&rev, 1, ev, sizeof(ev)) == 0) {
+			q2qt_parse(ev, &o);
+			if (o.kind != Q2QT_EV_NONE) {
+				q2qt_hex(h, sizeof h, ev, 6);
+				qt_diag(DL_EV0, h);
+			}
+			ready = q2qt_is_ready(&o);
+		}
+		if (!ready) {
+			qt_sleep_ms(20);
+		}
+	}
+	snprintf(b, sizeof b, "RESET %s %u", ready ? "READY" : "NO READY", tries);
+	qt_diag(DL_RESET, b);
+
+	sweet_fb_diag_stage = 72;
+	qt_diag(DL_STEP, "STEP SCAN ON");
+	(void)qt_write(ttype, sizeof(ttype));
+	qt_sleep_ms(10);
+	(void)qt_write(&clr, 1);
+	qt_sleep_ms(10);
+	int es = qt_write(scan, sizeof(scan));
+	qt_sleep_ms(20);
+	(void)qt_write(inten, sizeof(inten));
+	qt_sleep_ms(10);
+	snprintf(b, sizeof b, "SCAN %s", es ? "ERR" : "ON");
+	qt_diag(DL_SCAN, b);
+	/* Chip answered at all? An all-0x00 or all-0xFF id means nothing is driving MISO. */
+	bool alive = !((id[0] | id[1] | id[2] | id[3] | id[4]) == 0 ||
+	    (id[0] & id[1] & id[2] & id[3] & id[4]) == 0xff);
+	return alive || ready;
+}
+
+/*
+ * Fold modes (2026-11-24, "like the iPhone Duo videos"): iOS fixes its screen size when the
+ * display server starts, so each layout change is a size switch in the framebuffer driver plus
+ * a restart of backboardd/SpringBoard ("respring"). Trigger: a deliberate tap (down and up
+ * within 30..800 ms) on the panel that does not match the current layout: cover -> mode 0
+ * (iPhone size), inner -> mode 1 (inner shape). The hall pins have not been characterised
+ * folded yet, so touch decides. At most one switch per 8 s; an inner tap needs 2 s without
+ * cover presses (pressing the folded cover can also press the inner halves).
+ * Needs q2qmodes=1 (framebuffer side); q2qautofold=0 disables the trigger.
+ */
+extern int sweet_fb_request_mode(int mode);
+extern int sweet_fb_current_mode(void);
+static uint32_t qt_autofold = 1;
+static uint64_t qt_tap_down_us[2];          /* [0] cover, [1] inner */
+static uint64_t qt_mode_last_us;
+static int qt_mode_pending = -1;
+static uint64_t qt_mode_pending_us;
+static uint32_t qt_resprings;
+
+static int
+qt_respring_cb(proc_t p, void *arg)
+{
+	int *pids = arg;
+	const char *n = proc_best_name(p);
+	if (n != NULL && (strcmp(n, "backboardd") == 0 || strcmp(n, "SpringBoard") == 0) &&
+	    pids[0] < 4) {
+		pids[1 + pids[0]++] = proc_pid(p);
+	}
+	return PROC_RETURNED;
+}
+
+/* Restart the display server and home screen; launchd starts them again. */
+static void
+qt_respring(void)
+{
+	int pids[5] = { 0 };
+	proc_iterate(PROC_ALLPROCLIST, qt_respring_cb, pids, NULL, NULL);
+	for (int i = 0; i < pids[0]; i++) {
+		proc_signal(pids[1 + i], SIGKILL);
+	}
+	qt_resprings++;
+}
+
+/* Called for each panel after its poll: was = contact mask before this poll. */
+static void
+qt_fold_tap(const struct qt_ctl *c, uint32_t was, uint64_t now)
+{
+	if (!qt_autofold || sweet_fb_current_mode() < 0) {
+		return;
+	}
+	unsigned k = c->cover ? 0u : 1u;
+	if (was == 0 && c->mask != 0) {
+		qt_tap_down_us[k] = now;
+		return;
+	}
+	if (was == 0 || c->mask != 0 || qt_tap_down_us[k] == 0) {
+		return;
+	}
+	uint64_t dur = now - qt_tap_down_us[k];
+	qt_tap_down_us[k] = 0;
+	int want = c->cover ? 0 : 1;
+	if (dur < 30000u || dur > 800000u || want == sweet_fb_current_mode() || qt_mode_pending >= 0 ||
+	    now - qt_mode_last_us < 8000000u) {
+		return;
+	}
+	if (!c->cover && (qt_cv.mask != 0 || now - qt_cv.press_us < 2000000u)) {
+		return;     /* inner halves pressed by a cover tap, not an unfold */
+	}
+	if (sweet_fb_request_mode(want) == 0) {
+		qt_mode_last_us = now;
+		qt_mode_pending = want;
+		qt_mode_pending_us = now;
+	}
+}
+
+/* Once the framebuffer has switched, respring so iOS reopens it at the new size. */
+static void
+qt_fold_poll(uint64_t now)
+{
+	if (qt_mode_pending < 0) {
+		return;
+	}
+	if (sweet_fb_current_mode() == qt_mode_pending && now - qt_mode_pending_us > 150000u) {
+		qt_mode_pending = -1;
+		qt_respring();
+	} else if (now - qt_mode_pending_us > 3000000u) {
+		qt_mode_pending = -1;   /* framebuffer never applied it */
+	}
+}
+
+static void
+qt_thread(void *arg, wait_result_t res)
+{
+	unsigned delay_s = 20, div = 4;
+	char b[48];
+	(void)arg;
+	(void)res;
+	(void)PE_parse_boot_argn("q2qtouchdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("q2qtouchdiv", &div, sizeof(div));
+	if (div < 2 || div > 255) {
+		div = 4;
+	}
+	qt.i2c_us = 3;
+	(void)PE_parse_boot_argn("q2qti2cus", &qt.i2c_us, sizeof(qt.i2c_us));
+	if (qt.i2c_us == 0 || qt.i2c_us > 100) {
+		qt.i2c_us = 3;
+	}
+	qt.bb_us = 1;
+	(void)PE_parse_boot_argn("q2qtbbus", &qt.bb_us, sizeof(qt.bb_us));
+	if (qt.bb_us > 100) {
+		qt.bb_us = 1;
+	}
+	qt_in.map.maxx = qt_in.map.maxy = 4096;
+	(void)PE_parse_boot_argn("q2qtmx", &qt_in.map.maxx, sizeof(qt_in.map.maxx));
+	(void)PE_parse_boot_argn("q2qtmy", &qt_in.map.maxy, sizeof(qt_in.map.maxy));
+	(void)PE_parse_boot_argn("q2qtswap", &qt_in.map.swap, sizeof(qt_in.map.swap));
+	(void)PE_parse_boot_argn("q2qtfx", &qt_in.map.flipx, sizeof(qt_in.map.flipx));
+	(void)PE_parse_boot_argn("q2qtfy", &qt_in.map.flipy, sizeof(qt_in.map.flipy));
+	qt_cv.map.maxx = qt_cv.map.maxy = 4096;
+	(void)PE_parse_boot_argn("q2qtcmx", &qt_cv.map.maxx, sizeof(qt_cv.map.maxx));
+	(void)PE_parse_boot_argn("q2qtcmy", &qt_cv.map.maxy, sizeof(qt_cv.map.maxy));
+	(void)PE_parse_boot_argn("q2qtcswap", &qt_cv.map.swap, sizeof(qt_cv.map.swap));
+	(void)PE_parse_boot_argn("q2qtcfx", &qt_cv.map.flipx, sizeof(qt_cv.map.flipx));
+	(void)PE_parse_boot_argn("q2qtcfy", &qt_cv.map.flipy, sizeof(qt_cv.map.flipy));
+	(void)PE_parse_boot_argn("q2qtx0", &qt_in.map.minx, sizeof(qt_in.map.minx));
+	(void)PE_parse_boot_argn("q2qty0", &qt_in.map.miny, sizeof(qt_in.map.miny));
+	(void)PE_parse_boot_argn("q2qtcx0", &qt_cv.map.minx, sizeof(qt_cv.map.minx));
+	(void)PE_parse_boot_argn("q2qtcy0", &qt_cv.map.miny, sizeof(qt_cv.map.miny));
+	int want_in = 1, want_cv = 1;
+	(void)PE_parse_boot_argn("q2qtinner", &want_in, sizeof(want_in));
+	(void)PE_parse_boot_argn("q2qtcover", &want_cv, sizeof(want_cv));
+	qt_pm_bus.us = qt.i2c_us;
+	qt_in.int_pin = PIN_INT;
+	qt_cv.int_pin = PIN_CT_INT;
+	qt_cv.i2c = qt_cv.cover = true;
+	sweet_fb_diag_stage = 1;
+	qt_diag(DL_TITLE, "Q2Q TOUCH V8 DUO");
+	snprintf(b, sizeof b, "WAIT %uS DIV %u", delay_s, div);
+	qt_diag(DL_STEP, b);
+	qt_sleep_ms(delay_s * 1000u);
+	sweet_fb_diag_stage = 2;
+
+	qt_diag(DL_STEP, "STEP MAP");
+	qt.gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	qt.tlmm = ml_io_map(TLMM_PA, TLMM_SIZE);
+	qt.se = ml_io_map(SE_PA, SE_SIZE);
+	if (!qt.gcc || !qt.tlmm || !qt.se) {
+		sweet_fb_diag_stage = 91;
+		qt_diag(DL_STATE, "STOP: MAP FAILED");
+		goto out;
+	}
+	sweet_fb_diag_stage = 3;
+
+	/* ---- inner controller: SPI (bit-banged), s2dos05 power ---- */
+	if (want_in) {
+		qt_dl_off = 0;
+		qt.i2c = false;
+		qt_diag(DL_STEP, "STEP CLOCKS");
+		if (!qt_clocks()) {
+			sweet_fb_diag_stage = 92;
+			qt_diag(DL_STATE, "INNER: SE4 CLOCK OFF");
+			goto cover;
+		}
+		sweet_fb_diag_stage = 4;
+		qt_diag(DL_STEP, "STEP SE4");
+		if (!qt_se_setup(div)) {
+			sweet_fb_diag_stage = 93;
+			goto cover;
+		}
+		sweet_fb_diag_stage = 5;
+		qt_diag(DL_STEP, "STEP PINS");
+		snprintf(b, sizeof b, "P%03X %03X %03X %03X", qt_rd(qt.tlmm, TLMM_CFG(PIN_MISO)) & 0x3ffu,
+		    qt_rd(qt.tlmm, TLMM_CFG(PIN_CS)) & 0x3ffu, qt_rd(qt.tlmm, TLMM_CFG(PIN_INT)) & 0x3ffu,
+		    qt_rd(qt.tlmm, TLMM_IO(PIN_INT)) & 3u);
+		qt_diag(DL_PINS, b);
+		qt_pin(PIN_CS, 0, 0, 2, true, true);        /* CS idle high before the bus pins */
+		if (qt.bb) {
+			qt_pin(PIN_CLK, 0, 0, 6, true, false);  /* mode 0: clock idles low */
+			qt_pin(PIN_MOSI, 0, 0, 6, true, false);
+			qt_pin(PIN_MISO, 0, 0, 2, false, false);
+		} else {
+			qt_pin(PIN_MISO, 1, 0, 6, false, false);
+			qt_pin(PIN_MOSI, 1, 0, 6, false, false);
+			qt_pin(PIN_CLK, 1, 0, 6, false, false);
+		}
+		qt_pin(PIN_INT, 0, 0, 2, false, false);
+		delay(100);
+		sweet_fb_diag_stage = 6;
+		int pwr = 1;
+		(void)PE_parse_boot_argn("q2qtpwr", &pwr, sizeof(pwr));
+		if (pwr) {
+			sweet_fb_diag_stage = 60;
+			qt_diag(DL_STEP, "STEP POWER");
+			bool on = qt_power();
+			sweet_fb_diag_stage = on ? 61 : 62;
+			qt_sleep_ms(200);      /* controller boot after power-up */
+		}
+		qt_in.on = qt_chip_start();
+		qt_diag(DL_STATE, qt_in.on ? "INNER RUNNING" : "INNER: NO ANSWER ON SPI");
+	}
+
+cover:
+	/* ---- cover controller: I2C (bit-banged), s2mpb02 power; only if iOS is mirrored there ---- */
+	{
+		int32_t tx, ty;
+		if (want_cv && sweet_fb_touch_to_hid_cover(0x8000u, 0x8000u, &tx, &ty) >= 0) {
+			qt_dl_off = 20;
+			qt.i2c = true;
+			qt_diag(DL_TITLE, "COVER TOUCH");
+			snprintf(b, sizeof b, "CT P%03X %03X %03X %X", qt_rd(qt.tlmm, TLMM_CFG(PIN_CT_SDA)) & 0x3ffu,
+			    qt_rd(qt.tlmm, TLMM_CFG(PIN_CT_SCL)) & 0x3ffu, qt_rd(qt.tlmm, TLMM_CFG(PIN_CT_INT)) & 0x3ffu,
+			    qt_rd(qt.tlmm, TLMM_IO(PIN_CT_INT)) & 3u);
+			qt_diag(DL_PINS, b);
+			qt_pin(PIN_CT_INT, 0, 0, 2, false, false);
+			qt_diag(DL_STEP, "STEP POWER COVER");
+			(void)qt_power_cover();
+			qt_i2c_idle(&qt_ts_bus);
+			qt_sleep_ms(200);
+			qt_cv.on = qt_chip_start();
+			qt_diag(DL_STATE, qt_cv.on ? "COVER RUNNING" : "COVER: NO ANSWER ON I2C");
+			qt_dl_off = 0;
+		}
+	}
+	if (!qt_in.on && !qt_cv.on) {
+		sweet_fb_diag_stage = 94;
+		goto out;
+	}
+	sweet_fb_diag_stage = 8;
+
+	uint64_t last_draw = 0;
+	(void)PE_parse_boot_argn("q2qautofold", &qt_autofold, sizeof(qt_autofold));
+	(void)PE_parse_boot_argn("q2qfold", &qt_fold_mode, sizeof(qt_fold_mode));
+	(void)PE_parse_boot_argn("q2qfoldlvl", &qt_fold_level, sizeof(qt_fold_level));
+	if (qt_fold_mode != PIN_FOLDER_HALL && qt_fold_mode != PIN_HALL) {
+		qt_fold_mode = 0;
+	}
+	for (;;) {
+		uint64_t now = qt_now_us();
+		uint32_t g80 = qt_rd(qt.tlmm, TLMM_IO(PIN_FOLDER_HALL)) & 1u;
+		uint32_t g26 = qt_rd(qt.tlmm, TLMM_IO(PIN_HALL)) & 1u;
+		/*
+		 * 2026-11-24: the inner diag only shows while open, so remember every level each
+		 * pin has had since boot (bit0 = seen 0, bit1 = seen 1) and the levels it had at the
+		 * latest cover press (the phone is folded then).
+		 */
+		g80_seen |= 1u << g80;
+		g26_seen |= 1u << g26;
+		qt_fold_poll(now);
+		if (qt_fold_mode != 0) {
+			uint32_t lvl = qt_fold_mode == PIN_FOLDER_HALL ? g80 : g26;
+			qt_folded = (lvl == (qt_fold_level & 1u));
+		}
+		struct qt_ctl *ctls[2] = { &qt_in, &qt_cv };
+		for (int k = 0; k < 2; k++) {
+			struct qt_ctl *c = ctls[k], *other = ctls[k ^ 1];
+			if (!c->on) {
+				continue;
+			}
+			bool irq = !(qt_rd(qt.tlmm, TLMM_IO(c->int_pin)) & 1u);   /* active low */
+			bool changed = false;
+			if (irq || c->mask || (++c->ticks % 10u) == 0) {
+				int n = qt_poll(c, &changed);
+				if (n < 0 && c->mask) {
+					c->mask = 0;       /* bus trouble: release everything */
+					changed = true;
+				}
+			}
+			/*
+			 * Ownership (2026-11-20 on the device: a hand on the back of the unfolded
+			 * phone, or the folded inner halves pressing on each other, read as a contact
+			 * that never lifts, so "block while the other side is down" blocked forever).
+			 * The side with the most recent NEW finger-down owns HID; a resting contact
+			 * makes no new presses, so it never takes over.
+			 */
+			uint32_t was_mask = c->prev;
+			uint32_t pressed = c->mask & ~c->prev;
+			c->prev = c->mask;
+			qt_fold_tap(c, was_mask, now);   /* q2q fold modes: deliberate tap switches layout */
+			/*
+			 * Fold sensor (optional, q2qfold): folded -> only the cover may own, open ->
+			 * only the inner side. Without it: a new press takes over, except within
+			 * 250 ms of the owner's own new press (one finger seen by both controllers,
+			 * e.g. a press on the folded cover felt by the inner halves).
+			 */
+			bool allowed = true;
+			if (qt_fold_mode != 0) {
+				allowed = qt_folded ? c->cover : !c->cover;
+			}
+			if (pressed != 0) {
+				c->press_us = now;
+				if (c->cover) {
+					cv_press_g80 = g80;   /* folded: what the hall pins read now */
+					cv_press_g26 = g26;
+				}
+			}
+			/*
+			 * V8 (2026-11-23 on the device: folded, cover taps did nothing). A tap on the
+			 * folded cover also presses the inner halves together; the inner side is polled
+			 * first, took ownership, and the real cover press then fell inside the 250 ms
+			 * window. The cover therefore wins ties: it may take over from the inner side
+			 * even within the window. The inner side still cannot steal back within 250 ms.
+			 */
+			bool cover_tie = c->cover && qt_owner != NULL && !qt_owner->cover;
+			if (pressed != 0 && qt_owner != c && allowed &&
+			    (qt_owner == NULL || now - qt_owner->press_us > 250000u || qt_fold_mode != 0 ||
+			     cover_tie)) {
+				if (qt_owner != NULL && qt_owner->active != 0) {
+					qt_report(qt_owner, 0);    /* lift the old side's fingers */
+				}
+				qt_owner = c;
+			}
+			if (qt_owner == NULL && allowed) {
+				qt_owner = c;
+			}
+			if (qt_fold_mode != 0 && qt_owner == c && !allowed) {
+				qt_report(c, 0);
+				qt_owner = NULL;              /* folded state changed: release this side */
+			}
+			(void)other;
+			uint32_t report = (qt_owner == c) ? c->mask : 0;
+			if (c->mask) {
+				c->last_us = now;
+			}
+			if (changed || report != c->active) {
+				qt_report(c, report);
+			}
+		}
+		if (now - last_draw > 1000000u) {
+			last_draw = now;
+			snprintf(b, sizeof b, "IN EV%u A%X", qt_in.events, qt_in.active);
+			qt_diag(DL_RAW, b);
+			snprintf(b, sizeof b, "CV EV%u A%X", qt_cv.events, qt_cv.active);
+			qt_diag(DL_HID, b);
+			snprintf(b, sizeof b, "X%u E%u", qt.xfers, qt.errors);
+			qt_diag(DL_COUNT, b);
+			snprintf(b, sizeof b, "FOLD G80=%u G26=%u M%u %s", g80, g26, qt_fold_mode,
+			    qt_fold_mode ? (qt_folded ? "CLOSED" : "OPEN") : "-");
+			sweet_fb_diag(38, b);
+			snprintf(b, sizeof b, "SEEN G80 %s G26 %s CVP %u%u",
+			    g80_seen == 3u ? "0+1" : g80_seen == 2u ? "1" : "0",
+			    g26_seen == 3u ? "0+1" : g26_seen == 2u ? "1" : "0",
+			    cv_press_g80, cv_press_g26);
+			sweet_fb_diag(46, b);
+			snprintf(b, sizeof b, "MODE %d RESPRING %u", sweet_fb_current_mode(), qt_resprings);
+			sweet_fb_diag(47, b);
+			snprintf(b, sizeof b, "OWNER %s", qt_owner == &qt_cv ? "COVER" : qt_owner == &qt_in ? "INNER" : "NONE");
+			sweet_fb_diag(39, b);
+			/* calibration: cover lines 30..33, inner lines 34..37 */
+			struct qt_ctl *cs[2] = { &qt_cv, &qt_in };
+			for (unsigned k = 0; k < 2; k++) {
+				struct qt_ctl *c = cs[k];
+				unsigned l0 = 30u + 4u * k;
+				const char *n = k ? "IN" : "CV";
+				if (!c->seen) {
+					continue;
+				}
+				snprintf(b, sizeof b, "%s X %u-%u", n, c->xmin, c->xmax);
+				sweet_fb_diag(l0, b);
+				snprintf(b, sizeof b, "%s Y %u-%u", n, c->ymin, c->ymax);
+				sweet_fb_diag(l0 + 1, b);
+				snprintf(b, sizeof b, "%s 1ST %u %u", n, c->x1, c->y1);
+				sweet_fb_diag(l0 + 2, b);
+				snprintf(b, sizeof b, "%s LAST %u %u", n, c->xl, c->yl);
+				sweet_fb_diag(l0 + 3, b);
+			}
+		}
+		qt_sleep_ms(10);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+q2q_touch_init(void)
+{
+	int enabled = 1;
+	thread_t th;
+	if (qt.started) {
+		return;
+	}
+	qt.started = true;
+	(void)PE_parse_boot_argn("q2qtouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("Q2Q TOUCH: disabled (q2qtouch=0)\n");
+		return;
+	}
+	if (kernel_thread_start(qt_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("Q2Q TOUCH: kernel_thread_start failed\n");
+	}
+}
