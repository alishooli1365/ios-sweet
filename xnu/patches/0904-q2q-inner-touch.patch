+/* s2mpb02 (camera / cover PMIC, 7-bit address 0x59): the cover touch supplies. */
+#define S2MPB02_ADDR      0x59u
+#define S2MPB02_L8CTRL    0x25u   /* bit 7 enable; 0.6 V + 25 mV * sel: 1.8 V = 48 */
+#define S2MPB02_L14CTRL   0x2Bu   /* bit 7 enable; 2.8 V = 88 */
+#define S2MPB02_LDO_EN    0x80u
+#define S2MPB02_VSEL      0x7fu
+#define S2MPB02_SEL_1V8   48u
+#define S2MPB02_SEL_2V8   88u
+
+/* s2dos05 (display PMIC, 7-bit address 0x60): the inner touch supplies. */
+#define S2DOS05_ADDR     0x60u
+#define S2DOS05_DEV_ID   0x00u
+#define S2DOS05_EN       0x03u
+#define S2DOS05_LDO2_CFG 0x05u   /* 1.5 V + 25 mV * sel; 1.8 V = 12 */
+#define S2DOS05_LDO3_CFG 0x06u   /* 2.7 V + 25 mV * sel; 3.0 V = 12 */
+#define S2DOS05_EN_L2    (1u << 1)
+#define S2DOS05_EN_L3    (1u << 2)
+#define S2DOS05_VSEL     0x7fu
+#define S2DOS05_SEL_1V8  12u
+#define S2DOS05_SEL_3V0  12u
+
+/* Upper-case hex of n bytes, space separated, into out (cap includes the NUL). */
+static void
+q2qt_hex(char *out, uint32_t cap, const uint8_t *b, uint32_t n)
+{
+	static const char hx[] = "0123456789ABCDEF";
+	uint32_t o = 0;
+	for (uint32_t i = 0; i < n && o + 3 < cap; i++) {
+		if (i) {
+			out[o++] = ' ';
+		}
+		out[o++] = hx[b[i] >> 4];
+		out[o++] = hx[b[i] & 15u];
+	}
+	if (cap) {
+		out[o < cap ? o : cap - 1] = '\0';
+	}
+}
