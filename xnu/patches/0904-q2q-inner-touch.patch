diff --git a/bsd/dev/q2q_keys.c b/bsd/dev/q2q_keys.c
new file mode 100644
index 0000000..ae53127
--- /dev/null
+++ b/bsd/dev/q2q_keys.c
@@ -0,0 +1,244 @@
+/*
+ * q2q (Samsung Galaxy Z Fold3, SM8350) buttons for ios-sweet XNU: power, volume up, volume
+ * down, polled every 20 ms and reported with sweet_hid_key(). Same approach as ios-sweet's
+ * sweet_keys.c (Pixel 4a): PMIC access is READ ONLY, through the SPMI arbiter v5 observer
+ * channel (the only MMIO writes are EXT_READL commands); no PMIC configuration, interrupt or
+ * reset writes. The SM8350 arbiter sits at the same addresses as on SM7150 (lahaina.dtsi:
+ * core 0x0c440000, obsrvr 0x0e600000, cnfg 0x0c40a000).
+ * Boot-arg q2qkeys=0 disables it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+extern void sweet_fb_hud_show(unsigned seconds);   /* q2q info panel (SweetFramebuffer) */
+extern void sweet_fb_diag(unsigned line, const char *text);
+void q2q_keys_init(void);
+
+/*
+ * q2q (Galaxy Z Fold3) buttons, hardware-independent part (shared by q2q_keys.c and its host
+ * test). Facts from Samsung's SM-F926B source:
+ *  - power and volume down: PMK8350 (SPMI SID 0) PON "pon_hlos" at 0x1300, a PON gen3 block:
+ *    RT_STS = base + 0x10, KPDPWR_N = bit 7, RESIN_N = bit 6 (qpnp-power-on.c);
+ *  - volume up: gpio-keys on PM8350 (SID 1) GPIO 6, active low; PMIC GPIO n sits at
+ *    0x8800 + (n - 1) * 0x100, so GPIO 6 = 0x8D00; its live input level is RT_STS bit 0
+ *    (pinctrl-spmi-gpio.c PMIC_MPP_REG_RT_STS).
+ * SPMI PPID = SID << 8 | (register >> 8).
+ */
+#define Q2QK_PON_PPID     0x013u
+#define Q2QK_PON_RT       0x1310u
+#define Q2QK_PON_PWR_BIT  (1u << 7)
+#define Q2QK_PON_VDN_BIT  (1u << 6)
+#define Q2QK_VUP_PPID     0x18Du
+#define Q2QK_VUP_RT       0x8D10u
+#define Q2QK_VUP_MODE     0x8D40u
+#define Q2QK_VUP_EN       0x8D46u
+#define Q2QK_VUP_SUBTYPE  0x8D05u
+
+enum { Q2QK_POWER = 0, Q2QK_VOLUP = 1, Q2QK_VOLDOWN = 2, Q2QK_N = 3 };   /* sweet_hid_key ids */
+
+/* SPMI arbiter v5 observer EXT_READL command for one byte at addr (within the peripheral). */
+static uint32_t
+q2qk_obs_cmd(uint16_t addr)
+{
+	return (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+}
+
+/* Key states from the two raw registers. */
+static void
+q2qk_decode(uint8_t pon_rt, uint8_t vup_rt, int down[Q2QK_N])
+{
+	down[Q2QK_POWER] = (pon_rt & Q2QK_PON_PWR_BIT) ? 1 : 0;
+	down[Q2QK_VOLDOWN] = (pon_rt & Q2QK_PON_VDN_BIT) ? 1 : 0;
+	down[Q2QK_VOLUP] = (vup_rt & 1u) ? 0 : 1;      /* active low */
+}
+
+/* Is the PMIC GPIO enabled and an input (or input/output)? Read-only check, never repaired. */
+static int
+q2qk_gpio_is_input(uint8_t subtype, uint8_t mode, uint8_t en)
+{
+	unsigned dir = (subtype >= 0x10u && subtype <= 0x13u) ? (mode & 3u) : ((mode >> 4) & 7u);
+	return (en & 0x80u) && (dir == 0 || dir == 2);
+}
+
+#define QK_CORE_PA      0x0c440000u
+#define QK_OBS_PA       0x0e600000u
+#define QK_CNFG_PA      0x0c40a000u
+#define QK_NO_APID      0xffffu
+#define QK_DL           40u           /* diagnostic line (left bar, below the touch lines) */
+
+static vm_offset_t qk_core, qk_obs, qk_cnfg;
+static uint16_t qk_pon_apid = QK_NO_APID, qk_vup_apid = QK_NO_APID;
+static uint32_t qk_status;
+static bool qk_started;
+static int qk_chan;
+
+static uint32_t
+qk_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* A PPID may be mapped to more than one APID on v5; prefer the apps-owned (owner 0) entry. */
+static uint16_t
+qk_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = QK_NO_APID;
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t map = qk_rd(qk_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = qk_rd(qk_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == QK_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+qk_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == QK_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid;      /* observer channel of this APID, EE 0 */
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(qk_obs + off) = q2qk_obs_cmd(addr);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; i++) {
+		qk_status = qk_rd(qk_obs, off + 0x08u);
+		if (qk_status & 1u) {
+			if (qk_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)qk_rd(qk_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+qk_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&qk_chan, THREAD_UNINT, deadline);
+	(void)thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+qk_thread(void *arg, wait_result_t res)
+{
+	int state[Q2QK_N] = {0, 0, 0};
+	unsigned errors = 0;
+	unsigned combo_polls = 0;
+	bool combo_fired = false;
+	char b[48];
+	(void)arg;
+	(void)res;
+	for (;;) {
+		uint8_t pon = 0, vup = 1;
+		bool pok = qk_read(qk_pon_apid, Q2QK_PON_RT, &pon);
+		bool gok = qk_vup_apid != QK_NO_APID && qk_read(qk_vup_apid, Q2QK_VUP_RT, &vup);
+		int now[Q2QK_N];
+		q2qk_decode(pon, vup, now);
+		if (!pok && (errors++ % 250u) == 0) {
+			printf("Q2Q KEYS: PON read error, arbiter status %#x\n", qk_status);
+		}
+		for (int k = 0; k < Q2QK_N; k++) {
+			bool ok = (k == Q2QK_VOLUP) ? gok : pok;
+			if (ok && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("Q2Q KEYS: key %d %s (pon %#x vup %#x)\n", k, state[k] ? "down" : "up", pon, vup);
+				snprintf(b, sizeof b, "KEY %d %s P%02X V%02X", k, state[k] ? "DN" : "UP", pon, vup);
+				sweet_fb_diag(QK_DL + 1, b);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		/*
+		 * q2q info panel (2026-11-26): Vol Up + Vol Down held together ~1 s (50 polls of 20 ms)
+		 * shows the diagnostic lines over the picture for 20 s, once per hold.
+		 */
+		if (state[Q2QK_VOLUP] && state[Q2QK_VOLDOWN]) {
+			if (combo_polls < 50u) {
+				combo_polls++;
+			} else if (!combo_fired) {
+				combo_fired = true;
+				sweet_fb_hud_show(20);
+			}
+		} else {
+			combo_polls = 0;
+			combo_fired = false;
+		}
+		qk_wait_ms(20);
+	}
+}
+
+void
+q2q_keys_init(void)
+{
+	int enabled = 1;
+	thread_t th;
+	char b[48];
+	if (qk_started) {
+		return;
+	}
+	qk_started = true;
+	(void)PE_parse_boot_argn("q2qkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("Q2Q KEYS: disabled (q2qkeys=0)\n");
+		return;
+	}
+	qk_core = ml_io_map(QK_CORE_PA, 0x2000);
+	qk_cnfg = ml_io_map(QK_CNFG_PA, 0x1000);
+	qk_obs = ml_io_map(QK_OBS_PA, 0x10000);
+	if (!qk_core || !qk_cnfg || !qk_obs) {
+		printf("Q2Q KEYS: MMIO mapping failed\n");
+		return;
+	}
+	uint32_t version = qk_rd(qk_core, 0);
+	uint32_t count = qk_rd(qk_core, 4) & 0x7ffu;
+	if (version < 0x50000000u || version >= 0x70000000u || count == 0 || count > 512) {
+		printf("Q2Q KEYS: unsupported SPMI arbiter version %#x apids %u\n", version, count);
+		snprintf(b, sizeof b, "KEYS ARB %08X N%u", version, count);
+		sweet_fb_diag(QK_DL, b);
+		return;
+	}
+	qk_pon_apid = qk_find_apid(Q2QK_PON_PPID, count);
+	qk_vup_apid = qk_find_apid(Q2QK_VUP_PPID, count);
+	uint8_t pon = 0, vup = 0, mode = 0, en = 0, sub = 0;
+	bool pok = qk_read(qk_pon_apid, Q2QK_PON_RT, &pon);
+	bool gok = qk_read(qk_vup_apid, Q2QK_VUP_RT, &vup);
+	bool mok = qk_read(qk_vup_apid, Q2QK_VUP_MODE, &mode);
+	bool eok = qk_read(qk_vup_apid, Q2QK_VUP_EN, &en);
+	bool sok = qk_read(qk_vup_apid, Q2QK_VUP_SUBTYPE, &sub);
+	printf("Q2Q KEYS: arb %#x apids %u pon-apid %u vup-apid %u pon %#x/%d vup %#x/%d mode %#x en %#x sub %#x\n",
+	    version, count, qk_pon_apid, qk_vup_apid, pon, pok, vup, gok, mode, en, sub);
+	snprintf(b, sizeof b, "KEYS A%u/%u P%02X%c V%02X%c", qk_pon_apid & 0x3ffu, qk_vup_apid & 0x3ffu,
+	    pon, pok ? '+' : '-', vup, gok ? '+' : '-');
+	sweet_fb_diag(QK_DL, b);
+	/* GPIO configuration belongs to the bootloader: diagnose, never change it. */
+	if (!gok || !mok || !eok || !sok || !q2qk_gpio_is_input(sub, mode, en)) {
+		printf("Q2Q KEYS: PM8350 GPIO6 not confirmed as an enabled input; volume up withheld\n");
+		qk_vup_apid = QK_NO_APID;
+	}
+	if (kernel_thread_start(qk_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("Q2Q KEYS: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/q2q_seed.c b/bsd/dev/q2q_seed.c
new file mode 100644
index 0000000..53b0980
--- /dev/null
+++ b/bsd/dev/q2q_seed.c
@@ -0,0 +1,106 @@
+/*
+ * q2q file seeds (2026-11-23). Writes small configuration files onto the iOS root at boot,
+ * so a tweak does not need a 16 GB userdata reflash. A kernel thread waits for the root
+ * vnode, then creates each file that does not exist yet (owner mobile 501:501, mode 0600).
+ *
+ * Seed 1, status bar: with the presented display at the inner panel's own size
+ * (sweetfb_lw/lh 1767x2208) UIKit finds no status bar layout for the screen and draws its red
+ * placeholder bar. _UIStatusBarGetVisualProviderClassForScreen (UIKitCore 0x1891aaa80) first
+ * reads UIStatusBarVisualProviderClassName from the com.apple.UIKit defaults suite and, if it
+ * names a provider class, uses that ("WARNING: Using overridden status bar visual provider
+ * class"). Seed /var/mobile/Library/Preferences/com.apple.UIKit.plist with it.
+ *
+ * Boot-args: q2qseed=0 off; q2qsbclass=NAME provider class (default
+ * _UIStatusBarVisualProvider_Phone); q2qseedforce=1 rewrites files that already exist.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/kauth.h>
+#include <sys/kernel.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+extern vnode_t rootvnode;
+extern void sweet_fb_diag(unsigned line, const char *text);
+
+void q2q_seed_init(void);
+
+#define Q2Q_MOBILE 501
+
+static int
+q2q_seed_write(const char *path, const char *data, size_t len, int force)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int flags = O_CREAT | FWRITE | O_NOFOLLOW | (force ? O_TRUNC : O_EXCL);
+	int error = vnode_open(path, flags, 0600, 0, &vp, ctx);
+	if (error != 0) {
+		return error;           /* EEXIST: already there, leave it */
+	}
+	error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)len, 0, UIO_SYSSPACE,
+	    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), NULL, vfs_context_proc(ctx));
+	if (error == 0) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, Q2Q_MOBILE);
+		VATTR_SET(&va, va_gid, Q2Q_MOBILE);
+		VATTR_SET(&va, va_mode, 0600);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	(void)vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+static void
+q2q_seed_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	/* wait (up to ~2 min) for the root file system */
+	for (int i = 0; i < 1200 && rootvnode == NULLVP; i++) {
+		delay(100 * 1000);      /* 100 ms; long delays block the thread */
+	}
+	if (rootvnode == NULLVP) {
+		sweet_fb_diag(48, "SEED no root");
+		return;
+	}
+	delay(500 * 1000);
+	int force = 0;
+	(void)PE_parse_boot_argn("q2qseedforce", &force, sizeof(force));
+	char cls[64] = "_UIStatusBarVisualProvider_Phone";
+	(void)PE_parse_boot_argn("q2qsbclass", cls, sizeof(cls));
+
+	char plist[512];
+	int n = snprintf(plist, sizeof(plist),
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n"
+	    "\t<key>UIStatusBarVisualProviderClassName</key>\n\t<string>%s</string>\n"
+	    "</dict>\n</plist>\n", cls);
+	int e = (n > 0 && n < (int)sizeof(plist)) ?
+	    q2q_seed_write("/private/var/mobile/Library/Preferences/com.apple.UIKit.plist",
+	    plist, (size_t)n, force) : EINVAL;
+	char line[40];
+	snprintf(line, sizeof(line), "SEED uikit %s", e == 0 ? "written" : e == EEXIST ? "exists" : "err");
+	sweet_fb_diag(48, line);
+	printf("q2q seed: com.apple.UIKit.plist (%s): %d\n", cls, e);
+}
+
+void
+q2q_seed_init(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("q2qseed", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(q2q_seed_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
diff --git a/bsd/dev/q2q_touch.c b/bsd/dev/q2q_touch.c
new file mode 100644
index 0000000..ebccc5a
--- /dev/null
+++ b/bsd/dev/q2q_touch.c
@@ -0,0 +1,1607 @@
+/*
+ * q2q (Samsung Galaxy Z Fold3, SM8350) inner touchscreen for ios-sweet XNU.
+ *
+ * STMicro FTS9CU80F on QUP wrapper-0 serial engine 4 (SPI, 0x990000), chip select on GPIO23
+ * (driven as a plain GPIO, like Samsung's driver), interrupt line GPIO165 (used as a hint;
+ * the event FIFO is polled). Power comes from the display PMIC's s2dos05 LDO2/LDO3, which the
+ * bootloader leaves on with the panel ("regulator-boot-on"), so no PMIC writes here.
+ *
+ * Steps, each announced on the diagnostic lines in the left black bar BEFORE it runs, so a hang
+ * shows where it stopped:
+ *   clocks (GCC votes for wrapper-0 AHB/core and SE4, SE4 root on TCXO 19.2 MHz)
+ *   -> serial engine checks (SPI firmware, FIFO) -> FIFO-mode SPI setup -> pins
+ *   -> chip id -> system reset -> scan on -> poll events -> sweet_hid_touch().
+ * Boot-args: q2qtouch=0 off; q2qtouchdelay=<s> (20); q2qtouchdiv=<n> SPI clock 19.2 MHz / n (4);
+ *   q2qtmx/q2qtmy raw range (4096); q2qtswap, q2qtfx, q2qtfy orientation fixes.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc_internal.h>
+#include <sys/signal.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+extern void sweet_fb_diag(unsigned line, const char *text);
+extern int sweet_fb_touch_to_hid(uint32_t fx16, uint32_t fy16, int32_t *hx, int32_t *hy);
+extern int sweet_fb_touch_to_hid_cover(uint32_t fx16, uint32_t fy16, int32_t *hx, int32_t *hy);
+/* Progress number shown on the frame-side heartbeat line ("FB <s> T<stage>"):
+ * 1 started, 2 waited, 3 mapped, 4 clocks on, 5 SE4 set up, 6 pins, 60 powering touch,
+ * 61 touch power on, 62 PMIC did not answer / power not confirmed, 70 chip id, 71 reset,
+ * 72 scan on, 8 running; 9x = stopped (91 map, 92 clock, 93 SE4 not SPI/busy, 94 no answer). */
+extern volatile uint32_t sweet_fb_diag_stage;
+void q2q_touch_init(void);
+
+/*
+ * q2q (Galaxy Z Fold3) inner touch: hardware-independent pieces, shared by the kernel driver
+ * (q2q_touch.c) and the host test. STMicro FTS9CU80F on SPI, protocol facts taken from
+ * Samsung's GPL driver (drivers/input/touchscreen/stm/fts9cu80f_spi):
+ *  - a write of a "raw" command (A0 A2 A4 A7 FA FB) is sent as is; any other command gets a
+ *    C0 prefix;
+ *  - a read of 87 / A7 / A4 / FA / FB sends the command bytes, one turnaround byte, then the
+ *    data; any other register is first written (C0 prefix), then read with D1 + 2 address
+ *    bytes, one turnaround byte, then the data;
+ *  - events are 16 bytes: byte0 = event id (bits 0-1), touch id (2-5), action (6-7);
+ *    x = byte1 << 4 | byte3 >> 4, y = byte2 << 4 | byte3 & 15; byte7 bits 0-4 = events left.
+ */
+#define Q2QT_EVENT_SIZE   16u
+#define Q2QT_FIFO_MAX     31u
+#define Q2QT_FINGERS      10u
+
+enum { Q2QT_EV_NONE = 0, Q2QT_EV_TOUCH, Q2QT_EV_STATUS, Q2QT_EV_ERROR, Q2QT_EV_OTHER };
+enum { Q2QT_ACT_NONE = 0, Q2QT_ACT_PRESS, Q2QT_ACT_MOVE, Q2QT_ACT_RELEASE };
+
+struct q2qt_ev {
+	uint32_t kind, tid, action, x, y, ttype, left, stype, status_id;
+};
+
+static int
+q2qt_raw_cmd(uint8_t c)
+{
+	return c == 0xA0 || c == 0xA2 || c == 0xA4 || c == 0xA7 || c == 0xFA || c == 0xFB;
+}
+
+/* Frame for a register/command write. Returns the frame length (0 if it does not fit). */
+static uint32_t
+q2qt_frame_write(const uint8_t *cmd, uint32_t n, uint8_t *tx, uint32_t cap)
+{
+	uint32_t off = q2qt_raw_cmd(cmd[0]) ? 0 : 1;
+	if (n == 0 || n + off > cap) {
+		return 0;
+	}
+	if (off) {
+		tx[0] = 0xC0;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		tx[off + i] = cmd[i];
+	}
+	return n + off;
+}
+
+/*
+ * Frame for a read of rlen bytes. *pre is set when the register must first be written with
+ * q2qt_frame_write(reg, tlen). Returns the full-duplex length; the data starts at *data_off.
+ */
+static uint32_t
+q2qt_frame_read(const uint8_t *reg, uint32_t tlen, uint32_t rlen, uint8_t *tx, uint32_t cap,
+    uint32_t *data_off, int *pre)
+{
+	uint32_t hdr;
+	uint8_t c = reg[0];
+	if (tlen == 0) {
+		return 0;
+	}
+	if (c == 0x87 || c == 0xA7 || c == 0xA4 || c == 0xFA || c == 0xFB) {
+		hdr = tlen;
+		*pre = 0;
+	} else {
+		if (tlen > 3) {
+			return 0;
+		}
+		hdr = 3;
+		*pre = 1;
+	}
+	if (hdr + 1 + rlen > cap) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < hdr + 1 + rlen; i++) {
+		tx[i] = 0;
+	}
+	if (*pre) {
+		tx[0] = 0xD1;
+		tx[1] = tlen == 3 ? reg[1] : 0x00;
+		tx[2] = tlen == 1 ? 0x00 : reg[0];
+	} else {
+		for (uint32_t i = 0; i < tlen; i++) {
+			tx[i] = reg[i];
+		}
+	}
+	*data_off = hdr + 1;
+	return hdr + 1 + rlen;
+}
+
+static void
+q2qt_parse(const uint8_t *e, struct q2qt_ev *o)
+{
+	o->kind = Q2QT_EV_OTHER;
+	o->tid = (e[0] >> 2) & 15u;
+	o->action = e[0] >> 6;
+	o->x = ((uint32_t)e[1] << 4) | (e[3] >> 4);
+	o->y = ((uint32_t)e[2] << 4) | (e[3] & 15u);
+	o->ttype = (((uint32_t)e[6] >> 6) << 2) | (e[7] >> 6);
+	o->left = e[7] & 0x1fu;
+	o->stype = (e[0] >> 2) & 15u;
+	o->status_id = e[1];
+	int zero = 1;
+	for (uint32_t i = 0; i < Q2QT_EVENT_SIZE; i++) {
+		if (e[i] != 0) {
+			zero = 0;
+		}
+	}
+	if (zero) {
+		o->kind = Q2QT_EV_NONE;
+		o->left = 0;
+	} else if (e[0] == 0xF3) {
+		o->kind = Q2QT_EV_ERROR;
+	} else if ((e[0] & 3u) == 0) {
+		o->kind = (o->action == Q2QT_ACT_NONE || o->tid >= Q2QT_FINGERS) ?
+		    Q2QT_EV_OTHER : Q2QT_EV_TOUCH;
+	} else if ((e[0] & 3u) == 1) {
+		o->kind = Q2QT_EV_STATUS;
+	}
+}
+
+/* "Ready" status after a system reset: status event, information type (2), id 0. */
+static int
+q2qt_is_ready(const struct q2qt_ev *o)
+{
+	return o->kind == Q2QT_EV_STATUS && o->stype == 2 && o->status_id == 0;
+}
+
+/* Raw controller coordinates -> fractions (1/65536) of the upright view. */
+struct q2qt_map {
+	uint32_t maxx, maxy;   /* raw range end (exclusive) */
+	int swap, flipx, flipy;
+	uint32_t minx, miny;   /* raw range start (inclusive), default 0 */
+};
+
+static void
+q2qt_raw_to_view(const struct q2qt_map *m, uint32_t x, uint32_t y, uint32_t *fx16, uint32_t *fy16)
+{
+	uint32_t a = m->swap ? y : x, b = m->swap ? x : y;
+	uint32_t ma = m->swap ? m->maxy : m->maxx, mb = m->swap ? m->maxx : m->maxy;
+	uint32_t na = m->swap ? m->miny : m->minx, nb = m->swap ? m->minx : m->miny;
+	if (na >= ma) {
+		na = 0;
+	}
+	if (nb >= mb) {
+		nb = 0;
+	}
+	a = a > na ? a - na : 0;
+	b = b > nb ? b - nb : 0;
+	ma -= na;
+	mb -= nb;
+	if (ma == 0) {
+		ma = 1;
+	}
+	if (mb == 0) {
+		mb = 1;
+	}
+	if (a >= ma) {
+		a = ma - 1;
+	}
+	if (b >= mb) {
+		b = mb - 1;
+	}
+	uint64_t fa = ((uint64_t)a << 16) / ma, fb = ((uint64_t)b << 16) / mb;
+	if (m->flipx) {
+		fa = 0xffffu - fa;
+	}
+	if (m->flipy) {
+		fb = 0xffffu - fb;
+	}
+	*fx16 = (uint32_t)fa;
+	*fy16 = (uint32_t)fb;
+}
+
+/* GENI FIFO words: 4 bytes per word, first byte in bits 7:0. */
+static uint32_t
+q2qt_pack(const uint8_t *b, uint32_t n)
+{
+	uint32_t w = 0;
+	for (uint32_t i = 0; i < n && i < 4; i++) {
+		w |= (uint32_t)b[i] << (8 * i);
+	}
+	return w;
+}
+
+static void
+q2qt_unpack(uint32_t w, uint8_t *b, uint32_t n)
+{
+	for (uint32_t i = 0; i < n && i < 4; i++) {
+		b[i] = (uint8_t)(w >> (8 * i));
+	}
+}
+
+/*
+ * GPIO ("bit-banged") SPI, mode 0 (clock idle low, data sampled on the rising edge,
+ * changed after the falling edge), MSB first, full duplex. Used when the serial engine's FIFO
+ * interface is disabled (GSI-DMA-only firmware). The caller holds chip select low.
+ */
+struct q2qt_bb_ops {
+	void (*clk)(void *ctx, int level);
+	void (*mosi)(void *ctx, int level);
+	int (*miso)(void *ctx);
+	void (*wait)(void *ctx);      /* half a clock period */
+	void *ctx;
+};
+
+static void
+q2qt_bb_xfer(const struct q2qt_bb_ops *o, const uint8_t *tx, uint8_t *rx, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		uint8_t out = tx[i], in = 0;
+		for (int bit = 7; bit >= 0; bit--) {
+			o->mosi(o->ctx, (out >> bit) & 1);
+			o->wait(o->ctx);
+			o->clk(o->ctx, 1);
+			in = (uint8_t)((in << 1) | (o->miso(o->ctx) & 1));
+			o->wait(o->ctx);
+			o->clk(o->ctx, 0);
+		}
+		rx[i] = in;
+	}
+}
+
+/*
+ * GPIO ("bit-banged") I2C master, open drain emulated: a line is pulled low by driving 0 and
+ * released (pulled high by the board) by switching it to input. Used for the q2q i2c-gpio bus
+ * "i2c@52" (SDA gpio76, SCL gpio77) that carries the s2dos05 display PMIC at 0x60, whose LDO2
+ * (1.8 V) and LDO3 (3.0 V) power the inner touch controller.
+ */
+struct q2qt_i2c_ops {
+	void (*sda)(void *ctx, int release);
+	void (*scl)(void *ctx, int release);
+	int (*sda_in)(void *ctx);
+	int (*scl_in)(void *ctx);
+	void (*wait)(void *ctx);         /* quarter of a bit period */
+	void *ctx;
+};
+
+static int
+q2qt_i2c_scl_high(const struct q2qt_i2c_ops *o)
+{
+	o->scl(o->ctx, 1);
+	for (unsigned i = 0; i < 1000; i++) {   /* clock stretching */
+		if (o->scl_in(o->ctx)) {
+			o->wait(o->ctx);
+			return 0;
+		}
+		o->wait(o->ctx);
+	}
+	return -1;
+}
+
+static int
+q2qt_i2c_start(const struct q2qt_i2c_ops *o)
+{
+	o->sda(o->ctx, 1);
+	if (q2qt_i2c_scl_high(o)) {
+		return -1;
+	}
+	if (!o->sda_in(o->ctx)) {
+		return -2;                      /* bus held low by someone */
+	}
+	o->sda(o->ctx, 0);
+	o->wait(o->ctx);
+	o->scl(o->ctx, 0);
+	o->wait(o->ctx);
+	return 0;
+}
+
+static void
+q2qt_i2c_stop(const struct q2qt_i2c_ops *o)
+{
+	o->sda(o->ctx, 0);
+	o->wait(o->ctx);
+	(void)q2qt_i2c_scl_high(o);
+	o->sda(o->ctx, 1);
+	o->wait(o->ctx);
+}
+
+/* Returns 0 on ACK, 1 on NACK, -1 on a stuck clock. */
+static int
+q2qt_i2c_put(const struct q2qt_i2c_ops *o, uint8_t v)
+{
+	for (int bit = 7; bit >= 0; bit--) {
+		o->sda(o->ctx, (v >> bit) & 1);
+		o->wait(o->ctx);
+		if (q2qt_i2c_scl_high(o)) {
+			return -1;
+		}
+		o->scl(o->ctx, 0);
+		o->wait(o->ctx);
+	}
+	o->sda(o->ctx, 1);                  /* release for ACK */
+	o->wait(o->ctx);
+	if (q2qt_i2c_scl_high(o)) {
+		return -1;
+	}
+	int nack = o->sda_in(o->ctx);
+	o->scl(o->ctx, 0);
+	o->wait(o->ctx);
+	return nack ? 1 : 0;
+}
+
+static int
+q2qt_i2c_get(const struct q2qt_i2c_ops *o, int ack, uint8_t *v)
+{
+	uint8_t in = 0;
+	o->sda(o->ctx, 1);
+	for (int bit = 7; bit >= 0; bit--) {
+		o->wait(o->ctx);
+		if (q2qt_i2c_scl_high(o)) {
+			return -1;
+		}
+		in = (uint8_t)((in << 1) | (o->sda_in(o->ctx) & 1));
+		o->scl(o->ctx, 0);
+	}
+	o->sda(o->ctx, ack ? 0 : 1);
+	o->wait(o->ctx);
+	if (q2qt_i2c_scl_high(o)) {
+		return -1;
+	}
+	o->scl(o->ctx, 0);
+	o->wait(o->ctx);
+	o->sda(o->ctx, 1);
+	*v = in;
+	return 0;
+}
+
+/* Register read: START addr+W reg, repeated START addr+R, data, NACK, STOP. 0 = OK. */
+static int
+q2qt_i2c_read_reg(const struct q2qt_i2c_ops *o, uint8_t addr, uint8_t reg, uint8_t *v)
+{
+	int e = q2qt_i2c_start(o);
+	if (!e) e = q2qt_i2c_put(o, (uint8_t)(addr << 1));
+	if (!e) e = q2qt_i2c_put(o, reg);
+	if (!e) e = q2qt_i2c_start(o);
+	if (!e) e = q2qt_i2c_put(o, (uint8_t)((addr << 1) | 1u));
+	if (!e) e = q2qt_i2c_get(o, 0, v);
+	q2qt_i2c_stop(o);
+	return e;
+}
+
+static int
+q2qt_i2c_write_reg(const struct q2qt_i2c_ops *o, uint8_t addr, uint8_t reg, uint8_t v)
+{
+	int e = q2qt_i2c_start(o);
+	if (!e) e = q2qt_i2c_put(o, (uint8_t)(addr << 1));
+	if (!e) e = q2qt_i2c_put(o, reg);
+	if (!e) e = q2qt_i2c_put(o, v);
+	q2qt_i2c_stop(o);
+	return e;
+}
+
+/*
+ * General I2C transfer: write wn bytes, then (if rn) a repeated START and read rn bytes (ACK all
+ * but the last), then STOP. Used for the cover touch controller (fts9cu59 at 0x49): register
+ * writes are the raw command bytes, reads write the register then read (no dummy byte).
+ */
+static int
+q2qt_i2c_xfer(const struct q2qt_i2c_ops *o, uint8_t addr, const uint8_t *w, uint32_t wn,
+    uint8_t *r, uint32_t rn)
+{
+	int e = q2qt_i2c_start(o);
+	if (!e && wn) {
+		e = q2qt_i2c_put(o, (uint8_t)(addr << 1));
+		for (uint32_t i = 0; !e && i < wn; i++) {
+			e = q2qt_i2c_put(o, w[i]);
+		}
+		if (!e && rn) {
+			e = q2qt_i2c_start(o);
+		}
+	}
+	if (!e && rn) {
+		e = q2qt_i2c_put(o, (uint8_t)((addr << 1) | 1u));
+		for (uint32_t i = 0; !e && i < rn; i++) {
+			e = q2qt_i2c_get(o, i + 1 < rn, &r[i]);
+		}
+	}
+	q2qt_i2c_stop(o);
+	return e;
+}
