+/* q2q: diagnostic lines in the left bar (kept, redrawn after the first clear). */
+#define SWEET_DIAG_MAX_LINES 96
+static char sweet_fb_diag_text[SWEET_DIAG_MAX_LINES][40];
+static uintptr_t sweet_fb_diag_pixels;
+static uint32_t sweet_fb_diag_on;     /* boot-arg sweetfb_diag=1 shows them; default off */
+
+extern "C" void
+sweet_fb_diag(unsigned line, const char *text)
+{
+	if (line >= SWEET_DIAG_MAX_LINES) {
+		return;
+	}
+	uint32_t i = 0;
+	for (; text != NULL && text[i] != '\0' && i + 1 < sizeof(sweet_fb_diag_text[line]); i++) {
+		sweet_fb_diag_text[line][i] = text[i];
+	}
+	sweet_fb_diag_text[line][i] = '\0';
+	if (sweet_fb_diag_on && sweet_fb_rot_state.rot != 0 && sweet_fb_rot_cleared && sweet_fb_diag_pixels != 0) {
+		sweet_fb_diag_draw(&sweet_fb_rot_state, sweet_fb_diag_pixels, line, sweet_fb_diag_text[line]);
+	}
+}
+
+/*
+ * Heartbeat, once a second from the vsync timer: redraw every stored line (whatever cleared
+ * the bar since, e.g. the power-off fade) and show the frame-side counter plus the touch
+ * driver's progress number on the last line, independent of its text lines.
+ */
+extern "C" { volatile uint32_t sweet_fb_diag_stage; }
+
+static void
+sweet_fb_diag_tick(uint64_t ticks)
+{
+	if (!sweet_fb_diag_on || sweet_fb_rot_state.rot == 0 || !sweet_fb_rot_cleared || sweet_fb_diag_pixels == 0) {
+		return;
+	}
+	uint32_t last = sweet_fb_diag_lines(&sweet_fb_rot_state);
+	for (uint32_t dl = 0; dl < SWEET_DIAG_MAX_LINES && dl + 1 < last; dl++) {
+		if (sweet_fb_diag_text[dl][0] != '\0') {
+			sweet_fb_diag_draw(&sweet_fb_rot_state, sweet_fb_diag_pixels, dl, sweet_fb_diag_text[dl]);
+		}
+	}
+	char hb[32];
+	uint32_t n = 0;
+	hb[n++] = 'F'; hb[n++] = 'B'; hb[n++] = ' ';
+	n += sweet_fb_utoa(hb + n, ticks / 60u);
+	hb[n++] = ' '; hb[n++] = 'T';
+	n += sweet_fb_utoa(hb + n, sweet_fb_diag_stage);
+	hb[n] = '\0';
+	if (last > 0) {
+		sweet_fb_diag_draw(&sweet_fb_rot_state, sweet_fb_diag_pixels, last - 1, hb);
+	}
+}
+
+/* q2q touch: view fractions (1/65536) -> sweet_hid_touch() 1080x2400 coordinates. */
+extern "C" int
+sweet_fb_touch_to_hid(uint32_t fx16, uint32_t fy16, int32_t *hx, int32_t *hy)
