+
+/* q2q cover touch: fractions of the cover panel -> 1080x2400 (-1 when the mirror is off). */
+extern "C" int
+sweet_fb_touch_to_hid_cover(uint32_t fx16, uint32_t fy16, int32_t *hx, int32_t *hy)
+{
+	if (sweet_fb_cover_pixels == 0) {
+		return -1;
+	}
+	return sweet_fb_rot_view_to_hid(&sweet_fb_rot_cover, fx16, fy16, hx, hy);
+}
 
