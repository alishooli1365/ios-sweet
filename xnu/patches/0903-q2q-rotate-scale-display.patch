+/*
+ * q2q: rotated + scaled presentation (boot-arg sweetfb_rot=1 or 3).
+ *
+ * The Fold3 inner panel scans 2208x1768 (landscape) while iOS draws a 1125x2436 portrait
+ * display. Held upright, the panel is a 1768-wide, 2208-tall "portrait view" (px, py). The
+ * logical display is scaled to fit that view (nearest neighbour, aspect kept, centered, black
+ * bars) and rotated into the panel:
+ *   rot 1: panel x = py,            panel y = (fbH - 1) - px
+ *   rot 3: panel x = (fbW - 1) - py, panel y = px            (the opposite 90 degrees)
+ * Writes go along panel rows (contiguous); the source is read in 64-row tiles so its cache
+ * lines are reused across neighbouring panel rows.
+ */
+#define SWEET_FB_ROT_MAX  4096
+#define SWEET_FB_ROT_NONE 0xffffu
+#define SWEET_FB_ROT_TILE 64
+
+struct sweet_fb_rot {
+	uint32_t rot;                   /* 0 = off */
+	uint32_t fbW, fbH, fbRowBytes;  /* panel scan */
+	uint32_t pw, ph;                /* portrait view = fbH x fbW */
+	uint32_t lw, lh;                /* logical display */
+	uint32_t num, den;              /* scale = num / den */
+	uint32_t ox, oy, dw, dh;        /* scaled image inside the view */
+	uint16_t utab[SWEET_FB_ROT_MAX]; /* view px -> logical x, or NONE */
+	uint16_t vtab[SWEET_FB_ROT_MAX]; /* view py -> logical y, or NONE */
+};
+
+static int
+sweet_fb_rot_setup(struct sweet_fb_rot *r, uint32_t rot, uint32_t fbW, uint32_t fbH,
+    uint32_t fbRowBytes, uint32_t lw, uint32_t lh)
+{
+	r->rot = 0;
+	if ((rot != 1 && rot != 2 && rot != 3) || fbW == 0 || fbH == 0 || fbW > SWEET_FB_ROT_MAX ||
+	    fbH > SWEET_FB_ROT_MAX || lw == 0 || lh == 0 || lw >= SWEET_FB_ROT_NONE ||
+	    lh >= SWEET_FB_ROT_NONE || fbRowBytes < fbW * 4) {
+		return 0;
+	}
+	r->fbW = fbW; r->fbH = fbH; r->fbRowBytes = fbRowBytes;
+	if (rot == 2) {
+		r->pw = fbW; r->ph = fbH;       /* upright panel (Fold3 cover): scale only */
+	} else {
+		r->pw = fbH; r->ph = fbW;
+	}
+	r->lw = lw; r->lh = lh;
+	if ((uint64_t)r->pw * lh <= (uint64_t)r->ph * lw) {
+		r->num = r->pw; r->den = lw;    /* width-limited */
+	} else {
+		r->num = r->ph; r->den = lh;    /* height-limited (q2q: 2208 / 2436) */
+	}
+	r->dw = (uint32_t)((uint64_t)lw * r->num / r->den);
+	r->dh = (uint32_t)((uint64_t)lh * r->num / r->den);
+	if (r->dw > r->pw) {
+		r->dw = r->pw;
+	}
+	if (r->dh > r->ph) {
+		r->dh = r->ph;
+	}
+	r->ox = (r->pw - r->dw) / 2;
+	r->oy = (r->ph - r->dh) / 2;
+	for (uint32_t px = 0; px < SWEET_FB_ROT_MAX; px++) {
+		uint32_t u = SWEET_FB_ROT_NONE;
+		if (px >= r->ox && px < r->ox + r->dw) {
+			u = (uint32_t)((uint64_t)(px - r->ox) * r->den / r->num);
+			if (u >= lw) {
+				u = SWEET_FB_ROT_NONE;
+			}
+		}
+		r->utab[px] = (uint16_t)u;
+	}
+	for (uint32_t py = 0; py < SWEET_FB_ROT_MAX; py++) {
+		uint32_t v = SWEET_FB_ROT_NONE;
+		if (py >= r->oy && py < r->oy + r->dh) {
+			v = (uint32_t)((uint64_t)(py - r->oy) * r->den / r->num);
+			if (v >= lh) {
+				v = SWEET_FB_ROT_NONE;
+			}
+		}
+		r->vtab[py] = (uint16_t)v;
+	}
+	r->rot = rot;
+	return 1;
+}
+
+/* Black panel (volatile 32-bit stores: no DC ZVA on the uncached panel mapping). */
+static void
+sweet_fb_rot_clear(const struct sweet_fb_rot *r, uintptr_t fb)
+{
+	for (uint32_t y = 0; y < r->fbH; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(fb + (uint64_t)y * r->fbRowBytes);
+		for (uint32_t x = 0; x < r->fbW; x++) {
+			row[x] = 0;
+		}
+	}
+}
+
+/* One pixel at portrait-view coordinates (px, py); ignored outside the view. */
+static void
+sweet_fb_rot_putview(const struct sweet_fb_rot *r, uintptr_t fb, uint32_t px, uint32_t py,
+    uint32_t color)
+{
+	if (r->rot == 0 || px >= r->pw || py >= r->ph) {
+		return;
+	}
+	uint32_t fx = r->rot == 2 ? px : r->rot == 1 ? py : (r->fbW - 1) - py;
+	uint32_t fy = r->rot == 2 ? py : r->rot == 1 ? (r->fbH - 1) - px : px;
+	*(volatile uint32_t *)(fb + (uint64_t)fy * r->fbRowBytes + (uint64_t)fx * 4) = color;
+}
+
+/*
+ * Diagnostic text outside the iOS image (iOS never redraws there), 5x7 glyphs:
+ *  - left black bar (inner panel, bars at the sides): 3x scale, 18 px per character, 24 px
+ *    per line;
+ *  - otherwise the top black bar (cover panel, bars above and below): 2x scale, 12 px per
+ *    character, 16 px per line.
+ * Text starts 6 px in from the edges.
+ */
+#define SWEET_DIAG_X0     6u
+#define SWEET_DIAG_Y0     6u
+
+struct sweet_diag_area {
+	uint32_t x0, y0, cols, lines, scale;
+};
+
+static int
+sweet_fb_diag_area(const struct sweet_fb_rot *r, struct sweet_diag_area *a)
+{
+	a->x0 = SWEET_DIAG_X0;
+	a->y0 = SWEET_DIAG_Y0;
+	a->cols = a->lines = 0;
+	a->scale = 3;
+	if (r->rot == 0) {
+		return 0;
+	}
+	if (r->ox >= SWEET_DIAG_X0 * 2 + 18u * 10u) {
+		a->cols = (r->ox - SWEET_DIAG_X0 * 2) / 18u;
+		a->lines = (r->ph - SWEET_DIAG_Y0) / 24u;
+		return 1;
+	}
+	if (r->oy >= SWEET_DIAG_Y0 * 2 + 16u * 4u) {
+		a->scale = 2;
+		a->cols = (r->pw - SWEET_DIAG_X0 * 2) / 12u;
+		a->lines = (r->oy - SWEET_DIAG_Y0 * 2) / 16u;
+		return 1;
+	}
+	return 0;
+}
+
+static uint32_t
+sweet_fb_diag_cols(const struct sweet_fb_rot *r)
+{
+	struct sweet_diag_area a;
+	(void)sweet_fb_diag_area(r, &a);
+	return a.cols;
+}
+
+static uint32_t
+sweet_fb_diag_lines(const struct sweet_fb_rot *r)
+{
+	struct sweet_diag_area a;
+	(void)sweet_fb_diag_area(r, &a);
+	return a.lines;
+}
+
+/* Decimal digits of v at out (no NUL), at most 20; returns the count. */
+static uint32_t
+sweet_fb_utoa(char *out, uint64_t v)
+{
+	char t[20];
+	uint32_t n = 0;
+	do {
+		t[n++] = (char)('0' + (v % 10u));
+		v /= 10u;
+	} while (v != 0 && n < sizeof(t));
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = t[n - 1 - i];
+	}
+	return n;
+}
+
+/* Draw one text line (cleared to black first, cut at the bar width). */
+static void
+sweet_fb_diag_draw(const struct sweet_fb_rot *r, uintptr_t fb, uint32_t line, const char *text)
+{
+	struct sweet_diag_area a;
+	if (!sweet_fb_diag_area(r, &a) || a.cols == 0 || line >= a.lines) {
+		return;
+	}
+	uint32_t s = a.scale, adv = 6u * s, lh = 8u * s, cols = a.cols;
+	uint32_t y0 = a.y0 + line * lh;
+	for (uint32_t y = 0; y < lh; y++) {
+		for (uint32_t x = 0; x < cols * adv; x++) {
+			sweet_fb_rot_putview(r, fb, a.x0 + x, y0 + y, 0);
+		}
+	}
+	for (uint32_t c = 0; c < cols && text != NULL && text[c] != '\0'; c++) {
+		uint8_t ch = (uint8_t)text[c];
+		const uint8_t *g = sweet_diag_font[(ch >= 0x20 && ch < 0x80) ? ch - 0x20 : '?' - 0x20];
+		for (uint32_t gy = 0; gy < 7; gy++) {
+			for (uint32_t gx = 0; gx < 5; gx++) {
+				if (!(g[gy] & (0x10u >> gx))) {
+					continue;
+				}
+				for (uint32_t dy = 0; dy < s; dy++) {
+					for (uint32_t dx = 0; dx < s; dx++) {
+						sweet_fb_rot_putview(r, fb, a.x0 + c * adv + gx * s + dx,
+						    y0 + gy * s + dy, 0x00ffffffu);
+					}
+				}
+			}
+		}
+	}
+}
+
+/*
+ * Touch: a position in the portrait view, given as fractions of the view width / height in
+ * 1/65536 units, to the 1080 x 2400 coordinates sweet_hid_touch() expects (fractions of the
+ * logical display). Positions on the black bars are clamped to the nearest image edge.
+ * Returns 1 inside the image, 0 when clamped, -1 when rotation is off.
+ */
+static int
+sweet_fb_rot_view_to_hid(const struct sweet_fb_rot *r, uint32_t fx16, uint32_t fy16,
+    int32_t *hx, int32_t *hy)
+{
+	if (r->rot == 0) {
+		return -1;
+	}
+	if (fx16 > 0xffffu) {
+		fx16 = 0xffffu;
+	}
+	if (fy16 > 0xffffu) {
+		fy16 = 0xffffu;
+	}
+	int64_t px = (int64_t)(((uint64_t)fx16 * r->pw) >> 16);
+	int64_t py = (int64_t)(((uint64_t)fy16 * r->ph) >> 16);
+	int64_t u = (px - (int64_t)r->ox) * r->den / r->num;
+	int64_t v = (py - (int64_t)r->oy) * r->den / r->num;
+	int inside = 1;
+	if (px < (int64_t)r->ox || u < 0) {
+		u = 0; inside = 0;
+	}
+	if (py < (int64_t)r->oy || v < 0) {
+		v = 0; inside = 0;
+	}
+	if (u >= (int64_t)r->lw) {
+		u = r->lw - 1; inside = 0;
+	}
+	if (v >= (int64_t)r->lh) {
+		v = r->lh - 1; inside = 0;
+	}
+	*hx = (int32_t)(u * 1080 / r->lw);
+	*hy = (int32_t)(v * 2400 / r->lh);
+	return inside;
+}
+
+/*
+ * Show the logical rectangle (lx, ly, w, h), whose pixels start at source pixel (sx, sy) of a
+ * 32-bit surface at srcBase with srcRowBytes per row. The caller clips the rectangle to the
+ * logical display and to the surface.
+ */
+static void
+sweet_fb_rot_copy(const struct sweet_fb_rot *r, uintptr_t fb, uintptr_t srcBase,
+    uint32_t srcRowBytes, int32_t sx, int32_t sy, int32_t lx, int32_t ly, int32_t w, int32_t h)
+{
+	if (r->rot == 0 || w <= 0 || h <= 0 || lx < 0 || ly < 0 || sx < 0 || sy < 0) {
+		return;
+	}
+	uint32_t ux0 = (uint32_t)lx, ux1 = (uint32_t)(lx + w);
+	uint32_t vy0 = (uint32_t)ly, vy1 = (uint32_t)(ly + h);
+	uint32_t px0 = r->ox + (uint32_t)((uint64_t)ux0 * r->num / r->den);
+	uint32_t px1 = r->ox + (uint32_t)(((uint64_t)ux1 * r->num + r->den - 1) / r->den);
+	uint32_t py0 = r->oy + (uint32_t)((uint64_t)vy0 * r->num / r->den);
+	uint32_t py1 = r->oy + (uint32_t)(((uint64_t)vy1 * r->num + r->den - 1) / r->den);
+	if (px1 > r->ox + r->dw) {
+		px1 = r->ox + r->dw;
+	}
+	if (py1 > r->oy + r->dh) {
+		py1 = r->oy + r->dh;
+	}
+	if (r->rot == 2) {
+		/* upright: panel rows are view rows; read and write along rows */
+		for (uint32_t py = py0; py < py1; py++) {
+			uint32_t v = r->vtab[py];
+			if (v == SWEET_FB_ROT_NONE || v < vy0 || v >= vy1) {
+				continue;
+			}
+			const uint32_t *srow = (const uint32_t *)(srcBase +
+			    (uint64_t)((uint32_t)sy + (v - vy0)) * srcRowBytes);
+			uint32_t *drow = (uint32_t *)(fb + (uint64_t)py * r->fbRowBytes);
+			for (uint32_t px = px0; px < px1; px++) {
+				uint32_t u = r->utab[px];
+				if (u == SWEET_FB_ROT_NONE || u < ux0 || u >= ux1) {
+					continue;
+				}
+				drow[px] = srow[(uint32_t)sx + (u - ux0)];
+			}
+		}
+		return;
+	}
+	for (uint32_t pyb = py0; pyb < py1; pyb += SWEET_FB_ROT_TILE) {
+		uint32_t pye = pyb + SWEET_FB_ROT_TILE < py1 ? pyb + SWEET_FB_ROT_TILE : py1;
+		for (uint32_t px = px0; px < px1; px++) {
+			uint32_t u = r->utab[px];
+			if (u == SWEET_FB_ROT_NONE || u < ux0 || u >= ux1) {
+				continue;
+			}
+			uintptr_t col = srcBase + (uint64_t)((uint32_t)sx + (u - ux0)) * 4;
+			uint32_t fy = r->rot == 1 ? (r->fbH - 1) - px : px;
+			uint32_t *row = (uint32_t *)(fb + (uint64_t)fy * r->fbRowBytes);
+			for (uint32_t py = pyb; py < pye; py++) {
+				uint32_t v = r->vtab[py];
+				if (v == SWEET_FB_ROT_NONE || v < vy0 || v >= vy1) {
+					continue;
+				}
+				uint32_t fx = r->rot == 1 ? py : (r->fbW - 1) - py;
+				row[fx] = *(const uint32_t *)(col +
+				    (uint64_t)((uint32_t)sy + (v - vy0)) * srcRowBytes);
+			}
+		}
+	}
+}
