+
+/*
+ * q2q: rotated + scaled presentation (boot-arg sweetfb_rot=1 or 3).
+ *
+ * The Fold3 inner panel scans 2208x1768 (landscape) while iOS draws a 1125x2436 portrait
+ * display. Held upright, the panel is a 1768-wide, 2208-tall "portrait view" (px, py). The
+ * logical display is scaled to fit that view (nearest neighbour, aspect kept, centered, black
+ * bars) and rotated into the panel:
+ *   rot 1: panel x = py,            panel y = (fbH - 1) - px
+ *   rot 3: panel x = (fbW - 1) - py, panel y = px            (the opposite 90 degrees)
+ * Writes go along panel rows (contiguous); the source is read in 64-row tiles so its cache
+ * lines are reused across neighbouring panel rows.
+ */
+#define SWEET_FB_ROT_MAX  4096
+#define SWEET_FB_ROT_NONE 0xffffu
+#define SWEET_FB_ROT_TILE 64
+
+struct sweet_fb_rot {
+	uint32_t rot;                   /* 0 = off */
+	uint32_t fbW, fbH, fbRowBytes;  /* panel scan */
+	uint32_t pw, ph;                /* portrait view = fbH x fbW */
+	uint32_t lw, lh;                /* logical display */
+	uint32_t num, den;              /* x scale = num / den */
+	uint32_t ynum, yden;            /* y scale (equal to x unless stretched) */
+	uint32_t ox, oy, dw, dh;        /* scaled image inside the view */
+	uint16_t utab[SWEET_FB_ROT_MAX]; /* view px -> logical x, or NONE */
+	uint16_t vtab[SWEET_FB_ROT_MAX]; /* view py -> logical y, or NONE */
+};
+
+static void sweet_fb_rot_tables(struct sweet_fb_rot *r);
+
+static int
+sweet_fb_rot_setup(struct sweet_fb_rot *r, uint32_t rot, uint32_t fbW, uint32_t fbH,
+    uint32_t fbRowBytes, uint32_t lw, uint32_t lh)
+{
+	r->rot = 0;
+	if ((rot != 1 && rot != 2 && rot != 3) || fbW == 0 || fbH == 0 || fbW > SWEET_FB_ROT_MAX ||
+	    fbH > SWEET_FB_ROT_MAX || lw == 0 || lh == 0 || lw >= SWEET_FB_ROT_NONE ||
+	    lh >= SWEET_FB_ROT_NONE || fbRowBytes < fbW * 4) {
+		return 0;
+	}
+	r->fbW = fbW; r->fbH = fbH; r->fbRowBytes = fbRowBytes;
+	if (rot == 2) {
+		r->pw = fbW; r->ph = fbH;       /* upright panel (Fold3 cover): scale only */
+	} else {
+		r->pw = fbH; r->ph = fbW;
+	}
+	r->lw = lw; r->lh = lh;
+	if ((uint64_t)r->pw * lh <= (uint64_t)r->ph * lw) {
+		r->num = r->pw; r->den = lw;    /* width-limited */
+	} else {
+		r->num = r->ph; r->den = lh;    /* height-limited (q2q: 2208 / 2436) */
+	}
+	r->ynum = r->num; r->yden = r->den;
+	sweet_fb_rot_tables(r);
+	r->rot = rot;
+	return 1;
+}
+
+/*
+ * Image size, centering and lookup tables from the x and y scales. Both tables span the
+ * full 4096 entries so out-of-range view positions read as NONE.
+ */
+static void
+sweet_fb_rot_tables(struct sweet_fb_rot *r)
+{
+	uint32_t lw = r->lw, lh = r->lh;
+	r->dw = (uint32_t)((uint64_t)lw * r->num / r->den);
+	r->dh = (uint32_t)((uint64_t)lh * r->ynum / r->yden);
+	if (r->dw > r->pw) {
+		r->dw = r->pw;
+	}
+	if (r->dh > r->ph) {
+		r->dh = r->ph;
+	}
+	r->ox = (r->pw - r->dw) / 2;
+	r->oy = (r->ph - r->dh) / 2;
+	for (uint32_t px = 0; px < SWEET_FB_ROT_MAX; px++) {
+		uint32_t u = SWEET_FB_ROT_NONE;
+		if (px >= r->ox && px < r->ox + r->dw) {
+			u = (uint32_t)((uint64_t)(px - r->ox) * r->den / r->num);
+			if (u >= lw) {
+				u = SWEET_FB_ROT_NONE;
+			}
+		}
+		r->utab[px] = (uint16_t)u;
+	}
+	for (uint32_t py = 0; py < SWEET_FB_ROT_MAX; py++) {
+		uint32_t v = SWEET_FB_ROT_NONE;
+		if (py >= r->oy && py < r->oy + r->dh) {
+			v = (uint32_t)((uint64_t)(py - r->oy) * r->yden / r->ynum);
+			if (v >= lh) {
+				v = SWEET_FB_ROT_NONE;
+			}
+		}
+		r->vtab[py] = (uint16_t)v;
+	}
+}
+
+/*
+ * Stretch to fill the whole view (boot-args sweetfb_fill / sweetfb_cfill, 2026-11-23): x and
+ * y scale separately, no black bars, the aspect is not kept. Call after a successful setup.
+ */
+static void
+sweet_fb_rot_stretch(struct sweet_fb_rot *r)
+{
+	if (r->rot == 0) {
+		return;
+	}
+	r->num = r->pw; r->den = r->lw;
+	r->ynum = r->ph; r->yden = r->lh;
+	sweet_fb_rot_tables(r);
+}
+
+/* Black panel (volatile 32-bit stores: no DC ZVA on the uncached panel mapping). */
+static void
+sweet_fb_rot_clear(const struct sweet_fb_rot *r, uintptr_t fb)
+{
+	for (uint32_t y = 0; y < r->fbH; y++) {
+		volatile uint32_t *row = (volatile uint32_t *)(fb + (uint64_t)y * r->fbRowBytes);
+		for (uint32_t x = 0; x < r->fbW; x++) {
+			row[x] = 0;
+		}
+	}
+}
+
+/* One pixel at portrait-view coordinates (px, py); ignored outside the view. */
+static void
+sweet_fb_rot_putview(const struct sweet_fb_rot *r, uintptr_t fb, uint32_t px, uint32_t py,
+    uint32_t color)
+{
+	if (r->rot == 0 || px >= r->pw || py >= r->ph) {
+		return;
+	}
+	uint32_t fx = r->rot == 2 ? px : r->rot == 1 ? py : (r->fbW - 1) - py;
+	uint32_t fy = r->rot == 2 ? py : r->rot == 1 ? (r->fbH - 1) - px : px;
+	*(volatile uint32_t *)(fb + (uint64_t)fy * r->fbRowBytes + (uint64_t)fx * 4) = color;
+}
+
+/*
+ * Diagnostic text outside the iOS image (iOS never redraws there), 5x7 glyphs:
+ *  - left black bar (inner panel, bars at the sides): 3x scale, 18 px per character, 24 px
+ *    per line;
+ *  - otherwise the top black bar (cover panel, bars above and below): 2x scale, 12 px per
+ *    character, 16 px per line.
+ * Text starts 6 px in from the edges.
+ */
+#define SWEET_DIAG_X0     6u
+#define SWEET_DIAG_Y0     6u
+
+struct sweet_diag_area {
+	uint32_t x0, y0, cols, lines, scale;
+};
+
+static int
+sweet_fb_diag_area(const struct sweet_fb_rot *r, struct sweet_diag_area *a)
+{
+	a->x0 = SWEET_DIAG_X0;
+	a->y0 = SWEET_DIAG_Y0;
+	a->cols = a->lines = 0;
+	a->scale = 3;
+	if (r->rot == 0) {
+		return 0;
+	}
+	if (r->ox >= SWEET_DIAG_X0 * 2 + 18u * 10u) {
+		a->cols = (r->ox - SWEET_DIAG_X0 * 2) / 18u;
+		a->lines = (r->ph - SWEET_DIAG_Y0) / 24u;
+		return 1;
+	}
+	if (r->oy >= SWEET_DIAG_Y0 * 2 + 16u * 4u) {
+		a->scale = 2;
+		a->cols = (r->pw - SWEET_DIAG_X0 * 2) / 12u;
+		a->lines = (r->oy - SWEET_DIAG_Y0 * 2) / 16u;
+		return 1;
+	}
+	return 0;
+}
+
+static uint32_t
+sweet_fb_diag_cols(const struct sweet_fb_rot *r)
+{
+	struct sweet_diag_area a;
+	(void)sweet_fb_diag_area(r, &a);
+	return a.cols;
+}
+
+static uint32_t
+sweet_fb_diag_lines(const struct sweet_fb_rot *r)
+{
+	struct sweet_diag_area a;
+	(void)sweet_fb_diag_area(r, &a);
+	return a.lines;
+}
+
+/* Decimal digits of v at out (no NUL), at most 20; returns the count. */
+static uint32_t
+sweet_fb_utoa(char *out, uint64_t v)
+{
+	char t[20];
+	uint32_t n = 0;
+	do {
+		t[n++] = (char)('0' + (v % 10u));
+		v /= 10u;
+	} while (v != 0 && n < sizeof(t));
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = t[n - 1 - i];
+	}
+	return n;
+}
+
+/* Draw one text line (cleared to black first, cut at the bar width). */
+static void
+sweet_fb_diag_draw(const struct sweet_fb_rot *r, uintptr_t fb, uint32_t line, const char *text)
+{
+	struct sweet_diag_area a;
+	if (!sweet_fb_diag_area(r, &a) || a.cols == 0 || line >= a.lines) {
+		return;
+	}
+	uint32_t s = a.scale, adv = 6u * s, lh = 8u * s, cols = a.cols;
+	uint32_t y0 = a.y0 + line * lh;
+	for (uint32_t y = 0; y < lh; y++) {
+		for (uint32_t x = 0; x < cols * adv; x++) {
+			sweet_fb_rot_putview(r, fb, a.x0 + x, y0 + y, 0);
+		}
+	}
+	for (uint32_t c = 0; c < cols && text != NULL && text[c] != '\0'; c++) {
+		uint8_t ch = (uint8_t)text[c];
+		const uint8_t *g = sweet_diag_font[(ch >= 0x20 && ch < 0x80) ? ch - 0x20 : '?' - 0x20];
+		for (uint32_t gy = 0; gy < 7; gy++) {
+			for (uint32_t gx = 0; gx < 5; gx++) {
+				if (!(g[gy] & (0x10u >> gx))) {
+					continue;
+				}
+				for (uint32_t dy = 0; dy < s; dy++) {
+					for (uint32_t dx = 0; dx < s; dx++) {
+						sweet_fb_rot_putview(r, fb, a.x0 + c * adv + gx * s + dx,
+						    y0 + gy * s + dy, 0x00ffffffu);
+					}
+				}
+			}
+		}
+	}
+}
+
+/*
+ * Touch: a position in the portrait view, given as fractions of the view width / height in
+ * 1/65536 units, to the 1080 x 2400 coordinates sweet_hid_touch() expects (fractions of the
+ * logical display). Positions on the black bars are clamped to the nearest image edge.
+ * Returns 1 inside the image, 0 when clamped, -1 when rotation is off.
+ */
+static int
+sweet_fb_rot_view_to_hid(const struct sweet_fb_rot *r, uint32_t fx16, uint32_t fy16,
+    int32_t *hx, int32_t *hy)
+{
+	if (r->rot == 0) {
+		return -1;
+	}
+	if (fx16 > 0xffffu) {
+		fx16 = 0xffffu;
+	}
+	if (fy16 > 0xffffu) {
+		fy16 = 0xffffu;
+	}
+	int64_t px = (int64_t)(((uint64_t)fx16 * r->pw) >> 16);
+	int64_t py = (int64_t)(((uint64_t)fy16 * r->ph) >> 16);
+	int64_t u = (px - (int64_t)r->ox) * r->den / r->num;
+	int64_t v = (py - (int64_t)r->oy) * r->yden / r->ynum;
+	int inside = 1;
+	if (px < (int64_t)r->ox || u < 0) {
+		u = 0; inside = 0;
+	}
+	if (py < (int64_t)r->oy || v < 0) {
+		v = 0; inside = 0;
+	}
+	if (u >= (int64_t)r->lw) {
+		u = r->lw - 1; inside = 0;
+	}
+	if (v >= (int64_t)r->lh) {
+		v = r->lh - 1; inside = 0;
+	}
+	*hx = (int32_t)(u * 1080 / r->lw);
+	*hy = (int32_t)(v * 2400 / r->lh);
+	return inside;
+}
+
+/*
+ * Show the logical rectangle (lx, ly, w, h), whose pixels start at source pixel (sx, sy) of a
+ * 32-bit surface at srcBase with srcRowBytes per row. The caller clips the rectangle to the
+ * logical display and to the surface.
+ */
+/*
+ * Part `part` of `nparts` of that copy (2026-11-23, parallel present): the destination is split
+ * into bands of whole panel rows, so parts never write the same row and their union is exactly
+ * the full copy. rot 1/3 split the view x range (each view column is one panel row); rot 2
+ * splits view rows.
+ */
+static void
+sweet_fb_rot_copy_part(const struct sweet_fb_rot *r, uintptr_t fb, uintptr_t srcBase,
+    uint32_t srcRowBytes, int32_t sx, int32_t sy, int32_t lx, int32_t ly, int32_t w, int32_t h,
+    uint32_t part, uint32_t nparts);
+
+static void
+sweet_fb_rot_copy(const struct sweet_fb_rot *r, uintptr_t fb, uintptr_t srcBase,
+    uint32_t srcRowBytes, int32_t sx, int32_t sy, int32_t lx, int32_t ly, int32_t w, int32_t h)
+{
+	sweet_fb_rot_copy_part(r, fb, srcBase, srcRowBytes, sx, sy, lx, ly, w, h, 0, 1);
+}
+
+static void
+sweet_fb_rot_copy_part(const struct sweet_fb_rot *r, uintptr_t fb, uintptr_t srcBase,
+    uint32_t srcRowBytes, int32_t sx, int32_t sy, int32_t lx, int32_t ly, int32_t w, int32_t h,
+    uint32_t part, uint32_t nparts)
+{
+	if (r->rot == 0 || w <= 0 || h <= 0 || lx < 0 || ly < 0 || sx < 0 || sy < 0 ||
+	    nparts == 0 || part >= nparts) {
+		return;
+	}
+	uint32_t ux0 = (uint32_t)lx, ux1 = (uint32_t)(lx + w);
+	uint32_t vy0 = (uint32_t)ly, vy1 = (uint32_t)(ly + h);
+	uint32_t px0 = r->ox + (uint32_t)((uint64_t)ux0 * r->num / r->den);
+	uint32_t px1 = r->ox + (uint32_t)(((uint64_t)ux1 * r->num + r->den - 1) / r->den);
+	uint32_t py0 = r->oy + (uint32_t)((uint64_t)vy0 * r->ynum / r->yden);
+	uint32_t py1 = r->oy + (uint32_t)(((uint64_t)vy1 * r->ynum + r->yden - 1) / r->yden);
+	if (px1 > r->ox + r->dw) {
+		px1 = r->ox + r->dw;
+	}
+	if (py1 > r->oy + r->dh) {
+		py1 = r->oy + r->dh;
+	}
+	if (nparts > 1) {
+		uint32_t *lo = r->rot == 2 ? &py0 : &px0, *hi = r->rot == 2 ? &py1 : &px1;
+		if (*hi <= *lo) {
+			return;
+		}
+		uint32_t span = *hi - *lo, b0 = *lo;
+		*lo = b0 + (uint32_t)((uint64_t)span * part / nparts);
+		*hi = b0 + (uint32_t)((uint64_t)span * (part + 1) / nparts);
+	}
+	if (r->rot == 2) {
+		/* upright: panel rows are view rows; read and write along rows */
+		for (uint32_t py = py0; py < py1; py++) {
+			uint32_t v = r->vtab[py];
+			if (v == SWEET_FB_ROT_NONE || v < vy0 || v >= vy1) {
+				continue;
+			}
+			const uint32_t *srow = (const uint32_t *)(srcBase +
+			    (uint64_t)((uint32_t)sy + (v - vy0)) * srcRowBytes);
+			uint32_t *drow = (uint32_t *)(fb + (uint64_t)py * r->fbRowBytes);
+			for (uint32_t px = px0; px < px1; px++) {
+				uint32_t u = r->utab[px];
+				if (u == SWEET_FB_ROT_NONE || u < ux0 || u >= ux1) {
+					continue;
+				}
+				drow[px] = srow[(uint32_t)sx + (u - ux0)];
+			}
+		}
+		return;
+	}
+	for (uint32_t pyb = py0; pyb < py1; pyb += SWEET_FB_ROT_TILE) {
+		uint32_t pye = pyb + SWEET_FB_ROT_TILE < py1 ? pyb + SWEET_FB_ROT_TILE : py1;
+		for (uint32_t px = px0; px < px1; px++) {
+			uint32_t u = r->utab[px];
+			if (u == SWEET_FB_ROT_NONE || u < ux0 || u >= ux1) {
+				continue;
+			}
+			uintptr_t col = srcBase + (uint64_t)((uint32_t)sx + (u - ux0)) * 4;
+			uint32_t fy = r->rot == 1 ? (r->fbH - 1) - px : px;
+			uint32_t *row = (uint32_t *)(fb + (uint64_t)fy * r->fbRowBytes);
+			for (uint32_t py = pyb; py < pye; py++) {
+				uint32_t v = r->vtab[py];
+				if (v == SWEET_FB_ROT_NONE || v < vy0 || v >= vy1) {
+					continue;
+				}
+				uint32_t fx = r->rot == 1 ? py : (r->fbW - 1) - py;
+				row[fx] = *(const uint32_t *)(col +
+				    (uint64_t)((uint32_t)sy + (v - vy0)) * srcRowBytes);
+			}
+		}
+	}
+}
+
+static struct sweet_fb_rot sweet_fb_rot_state;
+static bool sweet_fb_rot_cleared;
+
+/*
+ * q2q "iPhone Duo": ABL leaves BOTH Fold3 panels scanning one buffer (stride 8832): the inner
+ * panel rows 0..1767 (2208 wide), the cover panel an 832x2268 window at row 1768 (SSPP 2/3,
+ * SRC_XY y=0x6E8). Every frame also goes, upright and scaled, into the cover window, so iOS
+ * shows on whichever side is in use. Boot-args: sweetfb_duo=0 off, sweetfb_cy/cw/ch window.
+ */
+static struct sweet_fb_rot sweet_fb_rot_cover;
+static uintptr_t sweet_fb_cover_pixels;
+static IOMemoryDescriptor *sweet_fb_cover_md;
+static IOMemoryMap *sweet_fb_cover_map;
+
+/*
+ * q2q parallel present (2026-11-23, "make it more smooth"). The rotate/scale copy of every
+ * frame (inner 1768x2208 view + cover 832x2268) ran on the vsync work loop alone, one core of
+ * eight. Each frame is now split into parts of whole panel rows (sweet_fb_rot_copy_part) and
+ * run on the work-loop thread plus up to SWEET_FB_HELPERS kernel-priority thread calls; present
+ * returns once every part is done, so the source surface is still held while it is read.
+ * Boot-arg sweetfb_par=N helpers (default 3, 0 = the old single-thread copy).
+ */
+#define SWEET_FB_JOBS_MAX 8
+#define SWEET_FB_HELPERS  3
+
+struct sweet_fb_job {
+	const struct sweet_fb_rot *r;
+	uintptr_t fb, src;
+	uint32_t rb;
+	int32_t sx, sy, lx, ly, w, h;
+	uint32_t part, nparts;
+};
+
+static struct sweet_fb_job sweet_fb_jobs[SWEET_FB_JOBS_MAX];
+static uint32_t sweet_fb_njobs, sweet_fb_next, sweet_fb_done;
+static IOLock *sweet_fb_plock;
+static thread_call_t sweet_fb_helper[SWEET_FB_HELPERS];
+static uint32_t sweet_fb_nhelpers;
+
+static void
+sweet_fb_job_run(const struct sweet_fb_job *b)
+{
+	sweet_fb_rot_copy_part(b->r, b->fb, b->src, b->rb, b->sx, b->sy, b->lx, b->ly, b->w, b->h,
+	    b->part, b->nparts);
+}
+
+/* Take parts until none are left; the last one to finish wakes the waiting present. */
+static void
+sweet_fb_run_jobs(void)
+{
+	for (;;) {
+		IOLockLock(sweet_fb_plock);
+		if (sweet_fb_next >= sweet_fb_njobs) {
+			IOLockUnlock(sweet_fb_plock);
+			return;
+		}
+		uint32_t j = sweet_fb_next++;
+		IOLockUnlock(sweet_fb_plock);
+		sweet_fb_job_run(&sweet_fb_jobs[j]);
+		IOLockLock(sweet_fb_plock);
+		if (++sweet_fb_done == sweet_fb_njobs) {
+			IOLockWakeup(sweet_fb_plock, &sweet_fb_done, false);
+		}
+		IOLockUnlock(sweet_fb_plock);
+	}
+}
+
+static void
+sweet_fb_helper_fn(thread_call_param_t p0, thread_call_param_t p1)
+{
+	(void)p0;
+	(void)p1;
+	sweet_fb_run_jobs();
+}
+
+static void
+sweet_fb_pool_init(uint32_t helpers)
+{
+	if (helpers > SWEET_FB_HELPERS) {
+		helpers = SWEET_FB_HELPERS;
+	}
+	if (helpers == 0 || sweet_fb_plock != NULL) {
+		return;
+	}
+	sweet_fb_plock = IOLockAlloc();
+	if (sweet_fb_plock == NULL) {
+		return;
+	}
+	for (uint32_t i = 0; i < helpers; i++) {
+		/* KERNEL: the parallel thread-call group (TCG_PARALLEL); HIGH runs calls in serial */
+		thread_call_t c = thread_call_allocate_with_priority(sweet_fb_helper_fn, NULL,
+		    THREAD_CALL_PRIORITY_KERNEL);
+		if (c != NULL) {
+			sweet_fb_helper[sweet_fb_nhelpers++] = c;
+		}
+	}
+}
+
+/* Queue `nparts` parts of one copy; false when the job table is full (caller runs it inline). */
+static bool
+sweet_fb_job_add(const struct sweet_fb_rot *r, uintptr_t fb, uintptr_t src, uint32_t rb,
+    int32_t sx, int32_t sy, int32_t lx, int32_t ly, int32_t w, int32_t h, uint32_t nparts)
+{
+	if (nparts == 0 || sweet_fb_njobs + nparts > SWEET_FB_JOBS_MAX) {
+		return false;
+	}
+	for (uint32_t p = 0; p < nparts; p++) {
+		struct sweet_fb_job *b = &sweet_fb_jobs[sweet_fb_njobs++];
+		b->r = r; b->fb = fb; b->src = src; b->rb = rb;
+		b->sx = sx; b->sy = sy; b->lx = lx; b->ly = ly; b->w = w; b->h = h;
+		b->part = p; b->nparts = nparts;
+	}
+	return true;
+}
+
+/* Copy one surface rectangle to the inner panel and (duo) the cover window, in parallel. */
+static void
+sweet_fb_present_rect(uintptr_t inner, uintptr_t src, uint32_t rb, int32_t sx, int32_t sy,
+    int32_t lx, int32_t ly, int32_t w, int32_t h)
+{
+	if (sweet_fb_plock == NULL || sweet_fb_nhelpers == 0) {
+		sweet_fb_rot_copy(&sweet_fb_rot_state, inner, src, rb, sx, sy, lx, ly, w, h);
+		if (sweet_fb_cover_pixels != 0) {
+			sweet_fb_rot_copy(&sweet_fb_rot_cover, sweet_fb_cover_pixels, src, rb, sx, sy, lx, ly, w, h);
+		}
+		return;
+	}
+	/*
+	 * Build the table under the lock: a helper entered for the previous frame may still be
+	 * starting, and must never see a half-written part or a count from two different frames.
+	 */
+	IOLockLock(sweet_fb_plock);
+	sweet_fb_njobs = 0;
+	sweet_fb_next = 0;
+	sweet_fb_done = 0;
+	(void)sweet_fb_job_add(&sweet_fb_rot_state, inner, src, rb, sx, sy, lx, ly, w, h, 4);
+	if (sweet_fb_cover_pixels != 0) {
+		(void)sweet_fb_job_add(&sweet_fb_rot_cover, sweet_fb_cover_pixels, src, rb, sx, sy, lx, ly,
+		    w, h, 2);
+	}
+	IOLockUnlock(sweet_fb_plock);
+	for (uint32_t i = 0; i < sweet_fb_nhelpers; i++) {
+		(void)thread_call_enter(sweet_fb_helper[i]);
+	}
+	sweet_fb_run_jobs();
+	IOLockLock(sweet_fb_plock);
+	while (sweet_fb_done < sweet_fb_njobs) {
+		(void)IOLockSleep(sweet_fb_plock, &sweet_fb_done, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_fb_plock);
+}
+
+/*
+ * q2q fold modes (2026-11-24): mode 0 = folded (iPhone X 1125x2436, right for the cover),
+ * mode 1 = open (the inner panel's own shape, 1767x2208). The touch driver asks for a mode
+ * (sweet_fb_request_mode); the vsync timer applies it between presents (logical size, view
+ * tables, ADT canvas) and the touch driver then restarts the display server, which reopens
+ * the framebuffer at the new size. Boot-args: q2qmodes=1 on, q2qfoldw/h, q2qopenw/h.
+ */
+static uint32_t sweet_fb_mode_lw[2], sweet_fb_mode_lh[2];
+static uint32_t sweet_fb_mode_rot, sweet_fb_mode_fill, sweet_fb_mode_cfill;
+static uint32_t sweet_fb_cover_w, sweet_fb_cover_h, sweet_fb_cover_rb;
+static volatile int sweet_fb_mode_req = -1;
+static volatile int sweet_fb_mode_cur = -1;
+static uint32_t sweet_fb_mode_switches;
+
+extern "C" int
+sweet_fb_request_mode(int mode)
+{
+	if (sweet_fb_mode_cur < 0 || mode < 0 || mode > 1) {
+		return -1;
+	}
+	sweet_fb_mode_req = mode;
+	return 0;
+}
+
+extern "C" int
+sweet_fb_current_mode(void)
+{
+	return sweet_fb_mode_cur;
+}
+
+/* Inner + cover view tables for logical size lw x lh (start() and mode switches). */
+static void
+sweet_fb_setup_views(uint32_t lw, uint32_t lh, uint32_t fbW, uint32_t fbH, uint32_t rb)
+{
+	if (sweet_fb_rot_setup(&sweet_fb_rot_state, sweet_fb_mode_rot, fbW, fbH, rb, lw, lh) &&
+	    sweet_fb_mode_fill) {
+		sweet_fb_rot_stretch(&sweet_fb_rot_state);
+	}
+	if (sweet_fb_cover_pixels != 0 && sweet_fb_rot_setup(&sweet_fb_rot_cover, 2, sweet_fb_cover_w,
+	    sweet_fb_cover_h, sweet_fb_cover_rb, lw, lh) && sweet_fb_mode_cfill) {
+		sweet_fb_rot_stretch(&sweet_fb_rot_cover);
+	}
+}
+
+/* IOMobileFramebuffer reads the canvas from IODeviceTree:/arm-io/disp0; keep it equal to the
+ * presented size, or QuartzCore asks for a hardware scaler this phone lacks. */
+static void
+sweet_fb_set_canvas(uint32_t w, uint32_t h)
+{
+	IORegistryEntry *e = IORegistryEntry::fromPath("/arm-io/disp0", gIODTPlane);
+	if (e != NULL) {
+		e->setProperty("canvas-width", &w, sizeof(w));
+		e->setProperty("canvas-height", &h, sizeof(h));
+		e->release();
+	}
+}
