+	return q2q_error;
+}
+
 struct getfsstat_struct {
 	user_addr_t     sfsp;
 	user_addr_t     *mp;
@@ -3890,8 +3914,10 @@ getfsstat64_callback(mount_t mp, void * arg)
 /*
  * Get statistics on all file systems in 64 bit mode.
  */
+int q2q_getfsstat64_real(proc_t p, struct getfsstat64_args *uap, int *retval);
+
 int
-getfsstat64(__unused proc_t p, struct getfsstat64_args *uap, int *retval)
+q2q_getfsstat64_real(__unused proc_t p, struct getfsstat64_args *uap, int *retval)
 {
 	user_addr_t sfsp;
 	int count, maxcount;
@@ -3924,6 +3950,15 @@ getfsstat64(__unused proc_t p, struct getfsstat64_args *uap, int *retval)
 	return 0;
 }
 
+/* q2q: traced entry (boot-arg q2qtrace=NAME) */
+int
+getfsstat64(proc_t p, struct getfsstat64_args *uap, int *retval)
+{
+	int q2q_error = q2q_getfsstat64_real(p, uap, retval);
+	q2q_trace_path("getfsstat64", 0, (uint32_t)uap->bufsize, (uint32_t)uap->flags, q2q_error, *retval);
+	return q2q_error;
+}
