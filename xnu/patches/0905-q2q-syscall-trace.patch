-fstatfs64(__unused struct proc *p, struct fstatfs64_args *uap, __unused int32_t *retval)
+q2q_fstatfs64_real(__unused struct proc *p, struct fstatfs64_args *uap, __unused int32_t *retval)
 {
 	struct vnode *vp;
 	struct mount *mp;
@@ -3649,6 +3664,15 @@ out:
 	return error;
 }
 
+/* q2q: traced entry (boot-arg q2qtrace=NAME) */
+int
+fstatfs64(struct proc *p, struct fstatfs64_args *uap, int32_t *retval)
+{
+	int q2q_error = q2q_fstatfs64_real(p, uap, retval);
